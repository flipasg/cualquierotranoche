---
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  zoomable?: boolean;
}
const {
  src,
  alt,
  loading = 'lazy',
  class: className,
  zoomable = false,
} = Astro.props;
let width = 1200,
  height = 1500;
let mediaSrc = src;
try {
  const media = await import('../generated/media.json');
  const items = media.default as Record<
    string,
    { src: string; width: number; height: number }
  >;
  const item = items[src];
  if (item) {
    mediaSrc = item.src;
    width = item.width;
    height = item.height;
  }
} catch {}
---

{
  zoomable ? (
    <a
      class="gallery-image-link"
      href={mediaSrc}
      data-image-viewer-trigger
      aria-label={`Ampliar imagen: ${alt}`}
      aria-haspopup="dialog"
      aria-controls="image-viewer"
    >
      <img
        src={mediaSrc}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        class={className}
      />
    </a>
  ) : (
    <img
      src={mediaSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class={className}
    />
  )
}

<style>
  .gallery-image-link {
    display: block;
    min-width: 0;
    align-self: start;
    cursor: zoom-in;
  }
</style>
