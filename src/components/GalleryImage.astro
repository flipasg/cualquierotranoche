---
import site from '../data/site.json';
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  zoomable?: boolean;
}
const {
  src,
  alt,
  loading = 'lazy',
  class: className,
  zoomable = false,
} = Astro.props;
let width = 1200,
  height = 1500;
let mediaSrc = src;
const imageSizing = site.ui.imageSizing ?? {};
const defaultSizes = imageSizing.default || '100vw';
const zoomableSizes = imageSizing.zoomable || defaultSizes;
const maxWidth = imageSizing.maxWidth ?? {};
const imageStyle = `--gallery-max-mobile:${maxWidth.mobile || '100%'};--gallery-max-tablet:${maxWidth.tablet || maxWidth.mobile || '100%'};--gallery-max-desktop:${maxWidth.desktop || maxWidth.tablet || maxWidth.mobile || '100%'};`;
try {
  const media = await import('../generated/media.json');
  const items = media.default as Record<
    string,
    { src: string; width: number; height: number }
  >;
  const item = items[src];
  if (item) {
    mediaSrc = item.src;
    width = item.width;
    height = item.height;
  }
} catch {}
---

{
  zoomable ? (
    <a
      class="gallery-image-link"
      href={mediaSrc}
      data-image-viewer-trigger
      aria-label={`Ampliar imagen: ${alt}`}
      aria-haspopup="dialog"
      aria-controls="image-viewer"
    >
      <img
        src={mediaSrc}
        alt={alt}
        width={width}
        height={height}
        sizes={zoomable ? zoomableSizes : defaultSizes}
        loading={loading}
        decoding="async"
        class={className}
        style={imageStyle}
      />
    </a>
  ) : (
    <img
      src={mediaSrc}
      alt={alt}
      width={width}
      height={height}
      sizes={zoomable ? zoomableSizes : defaultSizes}
      loading={loading}
      decoding="async"
      class={className}
      style={imageStyle}
    />
  )
}

<style>
  .gallery-image-link {
    display: block;
    min-width: 0;
    align-self: start;
    cursor: zoom-in;
    max-width: var(--gallery-max-mobile);
    touch-action: manipulation;
  }
  .gallery-image-link img,
  img {
    max-width: var(--gallery-max-mobile);
  }
  @media (min-width: 700px) {
    .gallery-image-link {
      max-width: var(--gallery-max-tablet);
    }
    .gallery-image-link img,
    img {
      max-width: var(--gallery-max-tablet);
    }
  }
  @media (min-width: 1100px) {
    .gallery-image-link {
      max-width: var(--gallery-max-desktop);
    }
    .gallery-image-link img,
    img {
      max-width: var(--gallery-max-desktop);
    }
  }
</style>
