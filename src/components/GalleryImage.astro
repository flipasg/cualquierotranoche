---
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { src, alt, loading = 'lazy', class: className } = Astro.props;
let width = 1200,
  height = 1500;
let mediaSrc = src;
try {
  const media = await import('../generated/media.json');
  const items = media.default as Record<
    string,
    { src: string; width: number; height: number }
  >;
  const item = items[src];
  if (item) {
    mediaSrc = item.src;
    width = item.width;
    height = item.height;
  }
} catch {}
---

<img
  src={mediaSrc}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class={className}
/>
