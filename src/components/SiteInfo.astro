---
import { site } from '../data';
import RichText from './RichText.astro';

interface Props {
  showContactLink?: boolean;
  showStudioInfo?: boolean;
  variant?: 'default' | 'contact';
}

const {
  showContactLink = true,
  showStudioInfo = false,
  variant = 'default',
} = Astro.props;
const contact = site.ui.contact;
const studio = contact.studio ?? {};
---

<div class="site-info">
  {
    variant === 'contact' ? (
      <>
        <div class="contact-site-links">
          <a href={`mailto:${site.email}`} data-responsive-external>
            {site.email}
          </a>
          <a href={site.instagram} rel="me noreferrer" data-responsive-external>
            {site.ui.footer.instagram}
          </a>
        </div>
        {showStudioInfo && studio.address && (
          <div class="studio-info">
            <p>
              <RichText content={studio.address} inline />
            </p>
            <div class="studio-links">
              {studio.addressLinkText && studio.addressLinkUrl && (
                <a
                  href={studio.addressLinkUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  {studio.addressLinkText}
                </a>
              )}
              {studio.mapText && studio.mapUrl && (
                <a href={studio.mapUrl} target="_blank" rel="noreferrer">
                  <RichText content={studio.mapText} inline />
                </a>
              )}
            </div>
          </div>
        )}
        <p class="site-copyright contact-copyright">
          © {contact.copyrightLabel?.trim() || site.name}
        </p>
      </>
    ) : (
      <>
        <strong>{site.artisticName}</strong>
        <p>
          <RichText content={site.ui.footer.disciplines} inline />
        </p>
        <div class="site-info-links">
          {showContactLink && (
            <>
              <a href="/contacto/">{site.ui.footer.contact}</a> ·{' '}
            </>
          )}
          <a href={`mailto:${site.email}`} data-responsive-external>
            {site.ui.footer.email}
          </a>{' '}
          ·{' '}
          <a href={site.instagram} rel="me noreferrer" data-responsive-external>
            {site.ui.footer.instagram}
          </a>
        </div>
        {showStudioInfo && (
          <div class="studio-info">
            {studio.address && (
              <p>
                <RichText content={studio.address} inline />
              </p>
            )}
            <div class="studio-links">
              {studio.addressLinkText && studio.addressLinkUrl && (
                <a
                  href={studio.addressLinkUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  {studio.addressLinkText}
                </a>
              )}
              {studio.mapText && studio.mapUrl && (
                <a href={studio.mapUrl} target="_blank" rel="noreferrer">
                  <RichText content={studio.mapText} inline />
                </a>
              )}
            </div>
          </div>
        )}
        <p class="site-copyright">
          {site.ui.footer.sampleNotice} © {new Date().getFullYear()}
        </p>
      </>
    )
  }
</div>

<style>
  .site-info {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0.25rem 0;
    color: var(--color-muted);
  }
  .site-info-links {
    margin-block: 1rem;
  }
  .contact-site-links {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .site-copyright {
    color: var(--color-accent);
  }
  .contact-copyright {
    margin: 0;
  }
  .studio-info {
    margin-bottom: 1rem;
  }
  .studio-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-link);
    text-decoration-line: underline;
    text-underline-offset: 0.25em;
  }
</style>
