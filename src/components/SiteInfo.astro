---
import { site } from '../data';

interface Props {
  showContactLink?: boolean;
  showStudioInfo?: boolean;
}

interface StudioInfo {
  address?: string;
  addressLinkText?: string;
  addressLinkUrl?: string;
  mapText?: string;
  mapUrl?: string;
}

const { showContactLink = true, showStudioInfo = false } = Astro.props;
const contact = site.ui.contact as typeof site.ui.contact & {
  studio?: StudioInfo;
};
const studio = contact.studio ?? {};
---

<div class="site-info">
  <strong>{site.artisticName}</strong>
  <p>{site.ui.footer.disciplines}</p>
  <div class="site-info-links">
    {
      showContactLink && (
        <>
          <a href="/contacto/">{site.ui.footer.contact}</a> ·{' '}
        </>
      )
    }
    <a href={`mailto:${site.email}`} data-responsive-external
      >{site.ui.footer.email}</a
    > · <a href={site.instagram} rel="me noreferrer" data-responsive-external
      >{site.ui.footer.instagram}</a
    >
  </div>
  {
    showStudioInfo && (
      <div class="studio-info">
        {studio.address && <p>{studio.address}</p>}
        <div class="studio-links">
          {studio.addressLinkText && studio.addressLinkUrl && (
            <a href={studio.addressLinkUrl} target="_blank" rel="noreferrer">
              {studio.addressLinkText}
            </a>
          )}
          {studio.mapText && studio.mapUrl && (
            <a href={studio.mapUrl} target="_blank" rel="noreferrer">
              {studio.mapText}
            </a>
          )}
        </div>
      </div>
    )
  }
  <p>{site.ui.footer.sampleNotice} © {new Date().getFullYear()}</p>
</div>

<style>
  .site-info {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0.25rem 0;
    color: var(--color-muted);
  }
  .site-info-links {
    margin-block: 1rem;
  }
  .studio-info {
    margin-bottom: 1rem;
  }
  .studio-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  a {
    display: inline-block;
    padding-block: 0.5rem;
  }
</style>
