---
import { site } from '../data';
import { analytics } from '../config/analytics';
import { richTextToPlainText } from '../lib/rich-text.mjs';
import AnalyticsConsent from './AnalyticsConsent.astro';
import RichText from './RichText.astro';

interface Props {
  showContactLink?: boolean;
  showStudioInfo?: boolean;
  variant?: 'default' | 'contact';
}

const {
  showContactLink = true,
  showStudioInfo = false,
  variant = 'default',
} = Astro.props;
const contact = site.ui.contact;
const studio = contact.studio ?? {};
// Both footers display the same address without editorial line breaks.
const address = studio.address?.replace(/\s*\r?\n\s*/g, ' ').trim();
const mapLabel = richTextToPlainText(studio.mapText);
const mapAccessibleName = mapLabel
  ? `${mapLabel}: ${richTextToPlainText(address)}`
  : undefined;
---

<div
  class:list={['site-info', { 'site-info--contact': variant === 'contact' }]}
>
  <strong class="site-name">{site.artisticName}</strong>
  <p class="site-disciplines">
    <RichText content={site.ui.footer.disciplines} inline />
  </p>
  <div class="site-info-links">
    {
      showContactLink && (
        <>
          <a href="/contacto/">{site.ui.footer.contact}</a>
          <span aria-hidden="true">·</span>
        </>
      )
    }
    <a href={`mailto:${site.email}`} data-responsive-external>
      {site.ui.footer.email}
    </a>
    <span aria-hidden="true">·</span>
    <a href={site.instagram} rel="me noreferrer" data-responsive-external>
      {site.ui.footer.instagram}
    </a>
  </div>
  {
    showStudioInfo && (
      <div class="studio-info">
        {address && (
          <p class="studio-address">
            {studio.mapUrl ? (
              <a
                href={studio.mapUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={mapAccessibleName}
              >
                <RichText content={address} inline />
              </a>
            ) : (
              <RichText content={address} inline />
            )}
          </p>
        )}
        {studio.addressLinkText && studio.addressLinkUrl && (
          <a href={studio.addressLinkUrl} target="_blank" rel="noreferrer">
            {studio.addressLinkText}
          </a>
        )}
      </div>
    )
  }
  <p class="site-copyright">
    {site.ui.footer.sampleNotice} © {new Date().getFullYear()}
  </p>
  <AnalyticsConsent
    config={analytics}
    origin={Astro.site?.origin ?? ''}
    owner={contact.copyrightLabel || site.name}
    email={site.email}
  />
</div>

<style>
  .site-info {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .site-name {
    font-size: 1rem;
  }
  p {
    margin: 0;
    color: var(--color-muted);
  }
  .site-info-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4em;
  }
  .site-copyright {
    color: var(--color-accent);
    font-size: 0.8rem;
  }
  .studio-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.5rem;
    color: var(--color-link);
    text-decoration-line: underline;
    text-underline-offset: 0.25em;
  }
  @media (min-width: 1360px) and (hover: hover) and (pointer: fine) {
    .site-info--contact {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: 1rem;
      row-gap: 0.35rem;
      font-size: 0.8rem;
      justify-content: space-between;
    }
    .site-info--contact .site-name {
      font-size: inherit;
    }
  }
</style>
