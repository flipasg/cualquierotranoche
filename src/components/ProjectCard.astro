---
import GalleryImage from './GalleryImage.astro';
import { site } from '../data';
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  project: any;
}
const { project } = Astro.props;
const projectHref = `/proyectos/${project.id}/`;
---

<article class="card discipline-card" data-reveal>
  <a
    class="discipline-card__link"
    href={projectHref}
    aria-label={project.data.title}
  >
    <GalleryImage
      src={project.data.cover}
      alt={project.data.coverAlt}
      sizes={site.ui.imageSizing.card || site.ui.imageSizing.default}
      class="discipline-card__image"
    /><div class="discipline-card__body">
      <h3>{project.data.title}</h3>
      {project.data.description && <p>{project.data.description}</p>}
      <span class="discipline-card__cta">
        {site.ui.illustration.projectCta}<ArrowIcon />
      </span>
    </div>
  </a>
</article>
