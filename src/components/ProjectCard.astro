---
import GalleryImage from './GalleryImage.astro';
interface Props {
  project: any;
}
const { project } = Astro.props;
---

<article class="card">
  <a href={`/ilustracion/${project.id}/`}
    ><GalleryImage src={project.data.cover} alt={project.data.coverAlt} /></a
  ><p class="eyebrow">Proyecto de muestra</p><h3>{project.data.title}</h3><p>
    {project.data.client} · {project.data.services} · {project.data.year}
  </p><a href={`/ilustracion/${project.id}/`}>Ver proyecto →</a>
</article>
