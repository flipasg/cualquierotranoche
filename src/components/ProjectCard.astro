---
import GalleryImage from './GalleryImage.astro';
import Eyebrow from './Eyebrow.astro';
import site from '../data/site.json';
interface Props {
  project: any;
}
const { project } = Astro.props;
---

<article class="card">
  <GalleryImage
    src={project.data.cover}
    alt={project.data.coverAlt}
    zoomable
  /><Eyebrow text={site.ui.illustration.projectCardEyebrow} /><h3>
    {project.data.title}
  </h3><p>
    {project.data.client} · {project.data.services} · {project.data.year}
  </p><a href={`/ilustracion/${project.id}/`}
    >{site.ui.illustration.projectCta}</a
  >
</article>
