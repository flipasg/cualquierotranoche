---
import GalleryImage from './GalleryImage.astro';
import site from '../data/site.json';
interface Props {
  project: any;
}
const { project } = Astro.props;
const projectHref = `/proyectos/${project.id}/`;
---

<article class="card">
  <a class="card__link" href={projectHref} aria-label={project.data.title}>
    <GalleryImage
      src={project.data.cover}
      alt={project.data.coverAlt}
      sizes={site.ui.imageSizing.card || site.ui.imageSizing.zoomable}
    /><h3>
      {project.data.title}
    </h3><span class="card__cta">{site.ui.illustration.projectCta}</span>
  </a>
</article>

<style>
  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card__cta {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .card__link:hover .card__cta,
  .card__link:focus-visible .card__cta {
    text-decoration-thickness: 2px;
  }
</style>
