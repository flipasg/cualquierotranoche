---
import GalleryImage from './GalleryImage.astro';
import site from '../data/site.json';
interface Props {
  project: any;
}
const { project } = Astro.props;
---

<article class="card">
  <GalleryImage
    src={project.data.cover}
    alt={project.data.coverAlt}
    zoomable
  /><h3>
    {project.data.title}
  </h3><a href={`/proyectos/${project.id}/`}
    >{site.ui.illustration.projectCta}</a
  >
</article>
