---
import site from '../data/site.json';
---

<footer>
  <div class="container footer-grid">
    <div>
      <strong>{site.artisticName}</strong><p>
        {site.ui.footer.disciplines}
      </p>
    </div><div>
      <a href="/contacto/">{site.ui.footer.contact}</a> · <a
        href={`mailto:${site.email}`}>{site.ui.footer.email}</a
      > · <a href={site.instagram} rel="me noreferrer"
        >{site.ui.footer.instagram}</a
      >
    </div><p>{site.ui.footer.sampleNotice} © {new Date().getFullYear()}</p>
  </div>
</footer><style>
  footer {
    border-top: 1px solid var(--color-border);
    padding-block: 3rem;
  }
  .footer-grid {
    display: grid;
    gap: 1rem;
  }
  footer p {
    margin: 0.25rem 0;
    color: var(--color-muted);
  }
</style>
