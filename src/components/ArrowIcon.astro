---
interface Props {
  direction?: 'right' | 'up';
}

const { direction = 'right' } = Astro.props;
---

<svg
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    direction === 'up' ? (
      <path d="M12 19V5m0 0-6 6m6-6 6 6" />
    ) : (
      <path d="M5 12h14m0 0-6-6m6 6-6 6" />
    )
  }
</svg>
