---
import { site } from '../data';
import TallyLink from './TallyLink.astro';
import { forms } from '../config/forms';

type HeaderLogo = {
  alt?: string;
  desktop?: string;
  tablet?: string;
  mobile?: string;
};

const pathname = Astro.url.pathname;
const navigation = site.navigation;
const header = site.ui.header as typeof site.ui.header & { logo?: HeaderLogo };
const headerLogo = header.logo ?? {};
const desktopLogo = headerLogo.desktop || '';
const tabletLogo = headerLogo.tablet || desktopLogo || '';
const mobileLogo = headerLogo.mobile || tabletLogo || desktopLogo || '';
const hasLogo = Boolean(desktopLogo || tabletLogo || mobileLogo);
const logoAlt = headerLogo.alt?.trim() || site.artisticName;
---

<header class="header" data-header data-menu-open="false">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`Inicio · ${logoAlt}`}>
      {
        hasLogo ? (
          <picture>
            {desktopLogo && (
              <source media="(min-width: 900px)" srcset={desktopLogo} />
            )}
            {tabletLogo && (
              <source media="(min-width: 700px)" srcset={tabletLogo} />
            )}
            <img
              src={mobileLogo || desktopLogo || tabletLogo}
              alt=""
              aria-hidden="true"
            />
          </picture>
        ) : (
          site.artisticName
        )
      }
    </a><div class="header-actions">
      <TallyLink className="header-cta" url={forms.tattoo}
        >{site.ui.header.tattooCta}</TallyLink
      ><button
        class="menu-toggle"
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false"
      >
        <span
          class="sr-only"
          data-open-label={site.ui.header.openMenu}
          data-close-label={site.ui.header.closeMenu}
          >{site.ui.header.openMenu}</span
        ><span aria-hidden="true">☰</span>
      </button>
    </div><nav
      id="primary-navigation"
      aria-label={site.ui.header.navigationLabel}
    >
      {
        navigation?.map((item) => {
          const isCurrentPage = pathname.startsWith(item.href);

          return (
            <a
              href={item.href}
              aria-current={isCurrentPage ? 'page' : undefined}
              data-nav-label={item.label}
            >
              <span class="nav-link-label">{item.label}</span>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .header-inner {
    display: flex;
    flex-direction: column;
    padding-block: 1rem;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-family);
    font-size: 1.35rem;
    text-decoration: none;
  }
  .brand picture {
    display: inline-flex;
    align-items: center;
  }
  .brand img {
    max-height: 3rem;
    width: auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .header-actions,
  .menu-toggle {
    display: none;
  }
  .header :global(.header-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }
  .header :global(.header-cta:hover),
  .header :global(.header-cta:focus-visible) {
    background: color-mix(in srgb, var(--color-accent), black 12%);
  }
  nav {
    display: flex;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
  }
  nav a {
    display: inline-grid;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.5rem;
    border: 1px solid transparent;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease,
      border-color var(--motion-fast) ease,
      color var(--motion-fast) ease,
      text-decoration-color var(--motion-fast) ease;
  }
  nav a::before,
  .nav-link-label {
    grid-area: 1 / 1;
  }
  nav a::before {
    content: attr(data-nav-label);
    font-weight: 700;
    visibility: hidden;
    white-space: nowrap;
  }
  nav a:hover,
  nav a:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 700;
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 700;
    text-decoration: none;
  }
  nav a:hover .nav-link-label,
  nav a:focus-visible .nav-link-label,
  nav a[aria-current='page'] .nav-link-label {
    font-weight: 700;
  }
  @media (max-width: 899px) {
    .header .header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      column-gap: 0.5rem;
      row-gap: 0.5rem;
      padding-block: 0.5rem;
    }
    .header .brand {
      grid-column: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .header .brand img {
      max-height: 2.25rem;
      max-width: min(55vw, 260px);
      object-fit: contain;
    }
    .header .header-actions {
      display: contents;
    }
    .header :global(.header-cta) {
      grid-column: 2;
      justify-self: end;
      min-height: 2.25rem;
      font-size: 0.8rem;
    }
    .header .menu-toggle {
      display: inline-flex;
      grid-column: 3;
      justify-self: end;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      min-height: 2.25rem;
      padding: 0;
      border: 1px solid var(--color-accent);
      border-radius: var(--radius);
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: 1.2rem;
      cursor: pointer;
    }
    .header nav {
      display: flex;
      grid-column: 1 / -1;
      flex-direction: column;
      gap: 0.25rem;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      padding-top: 0;
      pointer-events: none;
      visibility: hidden;
      transition:
        max-height 220ms var(--motion-ease),
        opacity var(--motion-fast) ease,
        padding-top var(--motion-fast) ease,
        visibility 0s linear 220ms;
    }
    .header[data-menu-open='true'] nav {
      max-height: 20rem;
      opacity: 1;
      padding-top: 0.5rem;
      pointer-events: auto;
      visibility: visible;
      transition-delay: 0s;
    }
  }
  @media (min-width: 900px) {
    .header-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .header-actions {
      display: flex;
      order: 2;
      margin-left: auto;
    }
    nav {
      order: 1;
      margin-left: auto;
    }
    .brand img {
      max-height: 2.75rem;
      max-width: 320px;
    }
  }
</style>

<script is:inline src="/scripts/header-menu.js"></script>
