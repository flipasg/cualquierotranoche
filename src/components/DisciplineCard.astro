---
import GalleryImage from './GalleryImage.astro';
import { type HomeDiscipline } from '../data';

type Props = HomeDiscipline;
const { title, text, href, linkLabel, image, imageAlt } = Astro.props;
---

<article class="card discipline-card" data-reveal>
  <a class="discipline-card__link" href={href} aria-label={linkLabel}>
    <GalleryImage
      src={`${image}`}
      alt={`${imageAlt}`}
      class="discipline-card__image"
    /><div class="discipline-card__body">
      <h3>{title}</h3><p>{text}</p><span>{linkLabel}</span>
    </div>
  </a>
</article>

<style>
  .discipline-card {
    padding-bottom: 0;
    border-bottom-color: var(--color-button-bg);
  }
  .discipline-card__link {
    display: grid;
    color: inherit;
    text-decoration: none;
    gap: 0;
    height: 100%;
  }
  .discipline-card__link :global(.discipline-card__image) {
    margin-bottom: 0;
  }
  .discipline-card__body {
    padding: 1rem;
    border: 1px solid var(--color-button-bg);
    border-bottom: 0;
  }
  .discipline-card__link:hover span {
    text-decoration: underline;
  }
</style>
