---
import GalleryImage from './GalleryImage.astro';
import ArrowIcon from './ArrowIcon.astro';
import RichText from './RichText.astro';
import { type HomeDiscipline } from '../data';

type Props = HomeDiscipline;
const { title, text, href, linkLabel, image, imageAlt } = Astro.props;
---

<article class="card discipline-card" data-reveal>
  <a class="discipline-card__link" href={href} aria-label={linkLabel}>
    <GalleryImage
      src={`${image}`}
      alt={`${imageAlt}`}
      class="discipline-card__image"
      sizes="(max-width: 359px) calc(100vw - 2.5rem), (max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) calc((100vw - 3rem - clamp(1rem, 3vw, 2.5rem)) / 2), min(calc((100vw - 6rem - clamp(2rem, 6vw, 5rem)) / 3), 28.334rem)"
    /><div class="discipline-card__body">
      <h3><RichText content={title} inline /></h3><RichText
        content={text}
        inline
      />
      <span class="discipline-card__cta">
        {linkLabel}<ArrowIcon />
      </span>
    </div>
  </a>
</article>
