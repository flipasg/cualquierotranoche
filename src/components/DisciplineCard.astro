---
import GalleryImage from './GalleryImage.astro';
import ArrowIcon from './ArrowIcon.astro';
import { type HomeDiscipline } from '../data';

type Props = HomeDiscipline;
const { title, text, href, linkLabel, image, imageAlt } = Astro.props;
---

<article class="card discipline-card" data-reveal>
  <a class="discipline-card__link" href={href} aria-label={linkLabel}>
    <GalleryImage
      src={`${image}`}
      alt={`${imageAlt}`}
      class="discipline-card__image"
    /><div class="discipline-card__body">
      <h3>{title}</h3><p>{text}</p><span class="discipline-card__cta">
        {linkLabel}<ArrowIcon />
      </span>
    </div>
  </a>
</article>

<style>
  .discipline-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-panel);
    padding-bottom: 0;
    transition:
      border-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }
  .discipline-card:hover,
  .discipline-card:focus-within {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
  }
  .discipline-card__link {
    display: grid;
    color: inherit;
    text-decoration: none;
    gap: 0;
    height: 100%;
  }
  .discipline-card__link :global(.discipline-card__image) {
    margin-bottom: 0;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: filter var(--motion-enter) var(--motion-ease);
  }
  .discipline-card__link:hover :global(.discipline-card__image),
  .discipline-card__link:focus-visible :global(.discipline-card__image) {
    filter: saturate(0.82) brightness(0.94);
  }
  .discipline-card__body {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
  }
  .discipline-card__body h3,
  .discipline-card__body p {
    margin: 0;
  }
  .discipline-card__body p {
    color: var(--color-muted);
  }
  .discipline-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.5rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-button-bg);
    border-radius: var(--radius);
    background: var(--color-button-bg);
    color: var(--color-button-text);
    font-size: 0.9rem;
    font-weight: 700;
    transition:
      background-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }
  .discipline-card__link:hover .discipline-card__cta,
  .discipline-card__link:focus-visible .discipline-card__cta {
    background: color-mix(in srgb, var(--color-button-bg), black 12%);
  }
  .discipline-card__link:hover .discipline-card__cta svg,
  .discipline-card__link:focus-visible .discipline-card__cta svg {
    transform: translateX(3px);
  }
  .discipline-card__cta svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--motion-fast) ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .discipline-card,
    .discipline-card__link :global(.discipline-card__image),
    .discipline-card__cta svg {
      transition: none;
    }
    .discipline-card__link:hover .discipline-card__cta svg,
    .discipline-card__link:focus-visible .discipline-card__cta svg {
      transform: none;
    }
    .discipline-card:hover,
    .discipline-card:focus-within {
      transform: none;
    }
  }
</style>
