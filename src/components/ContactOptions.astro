---
import { forms } from '../config/forms';
import { site } from '../data';
import TallyLink from './TallyLink.astro';

const options = [
  [site.ui.forms.tattoo, site.ui.forms.tattooDescription, forms.tattoo],
  [site.ui.forms.artwork, site.ui.forms.artworkDescription, forms.artwork],
  [
    site.ui.forms.illustration,
    site.ui.forms.illustrationDescription,
    forms.illustration,
  ],
  [site.ui.forms.general, site.ui.forms.generalDescription, forms.general],
] as const;
---

<ul class="contact-options">
  {
    options.map(([label, description, url]) => (
      <li>
        <TallyLink
          url={url}
          params={{ source: 'portfolio-contacto' }}
          className="contact-option-link"
          linkStyle
        >
          <span class="contact-option-copy">
            <span class="contact-option-title">{label}</span>
            {description && (
              <span class="contact-option-description">{description}</span>
            )}
          </span>
          <span class="contact-option-arrow" aria-hidden="true">
            →
          </span>
          <span class="sr-only">
            {site.ui.contact.actionLabel ?? 'Escríbeme'}
          </span>
        </TallyLink>
      </li>
    ))
  }
</ul>

<style>
  .contact-options {
    display: grid;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .contact-options li {
    border-bottom: 1px solid var(--color-border);
  }
  .contact-options li:first-child {
    border-top: 1px solid var(--color-border);
  }
  .contact-options :global(.contact-option-link) {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0;
    color: var(--color-text);
    font-weight: 400;
    text-decoration: none;
  }
  .contact-option-copy {
    display: grid;
    gap: 0.15rem;
  }
  .contact-option-title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .contact-option-description {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 400;
  }
  .contact-option-arrow {
    flex: 0 0 auto;
    font-size: 1.7rem;
    line-height: 1;
    transition: transform var(--motion-fast) ease;
  }
  .contact-options :global(.contact-option-link:hover .contact-option-arrow),
  .contact-options
    :global(.contact-option-link:focus-visible .contact-option-arrow) {
    transform: translateX(0.25rem);
  }
  .contact-options :global(.contact-option-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .contact-options :global(.unavailable) {
    padding: 1rem 0;
    border: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
