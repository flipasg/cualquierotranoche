---
import { forms } from '../config/forms';
import { site } from '../data';
import TallyLink from './TallyLink.astro';
const options = [
  [site.ui.forms.tattoo, forms.tattoo],
  [site.ui.forms.artwork, forms.artwork],
  [site.ui.forms.illustration, forms.illustration],
  [site.ui.forms.general, forms.general],
] as const;
---

<div class='contact-options'>
  {
    options.map(([label, url]) => (
      <TallyLink
        url={url}
        params={{ source: 'portfolio-contacto' }}
        secondary
        className='contact-option'
      >
        {label}
      </TallyLink>
    ))
  }
</div>

<style>
  .contact-options {
    display: grid;
    gap: 0.75rem;
  }
  .contact-options :global(.contact-option) {
    justify-content: flex-start;
    text-align: left;
  }
  .contact-options :global(.contact-option:hover) {
    background: var(--color-panel);
  }
</style>
