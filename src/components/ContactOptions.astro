---
import { forms } from '../config/forms';
import TallyLink from './TallyLink.astro';
const options = [
  ['Tattoo', forms.tattoo],
  ['Obra original', forms.artwork],
  ['Ilustración', forms.illustration],
  ['Otra consulta', forms.general],
  ['Avisos por ciudad', forms.cityAlerts],
] as const;
---

<div class="grid grid-2">
  {
    options.map(([label, url]) => (
      <TallyLink url={url} params={{ source: 'portfolio-contacto' }} secondary>
        {label}
      </TallyLink>
    ))
  }
</div>
