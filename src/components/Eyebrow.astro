---
import { eyebrowContent } from '../lib/eyebrow';

interface Props {
  text?: string | null;
  prefix?: string | null;
  suffix?: string | null;
}

const { text, prefix, suffix } = Astro.props;
const eyebrow = eyebrowContent(text, prefix, suffix);
---

{eyebrow && <p class="eyebrow">{eyebrow.content}</p>}
