---
import { site } from '../data';
interface Props {
  id: string;
  label: string;
  viewAllHref: string;
  viewAllLabel: string;
}

const { id, label, viewAllHref, viewAllLabel } = Astro.props;
---

<div class='carousel' data-carousel>
  <div class='carousel-heading'>
    <h2>{label}</h2>
    <div class='carousel-actions'>
      <a href={viewAllHref}>{viewAllLabel}</a>
      <div
        class='carousel-controls'
        data-carousel-controls
        aria-label={`${site.ui.carousel.controlsPrefix} ${label}`}
        hidden
      >
        <button type='button' data-carousel-previous aria-controls={id}>
          {site.ui.carousel.previous}
        </button><button type='button' data-carousel-next aria-controls={id}>
          {site.ui.carousel.next}
        </button>
      </div>
    </div>
  </div><div
    id={id}
    class='carousel-track'
    data-carousel-track
    tabindex='0'
    aria-label={label}
  >
    <slot />
  </div>
</div>

<style>
  .carousel {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }
  .carousel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .carousel-heading h2 {
    margin: 0;
  }
  .carousel-actions {
    display: grid;
    justify-items: end;
    gap: 0.375rem;
    margin-left: auto;
  }
  .carousel-controls[hidden] {
    display: none;
  }
  .carousel-controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .carousel-controls button {
    min-height: 2rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .carousel-track {
    display: grid;
    grid-auto-columns: minmax(84%, 1fr);
    grid-auto-flow: column;
    gap: var(--space);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track :global(.carousel-item) {
    min-width: 0;
    scroll-snap-align: start;
  }
  .carousel-track :global(.carousel-item > .card) {
    height: 100%;
  }
  @media (min-width: 700px) {
    .carousel-track {
      grid-auto-columns: minmax(20rem, 48%);
    }
  }
  @media (min-width: 1024px) {
    .carousel-track {
      grid-auto-columns: minmax(20rem, 31%);
    }
  }
</style>

<script is:inline type='module' src='/scripts/content-carousel.js'></script>
