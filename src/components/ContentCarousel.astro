---
import { site } from '../data';
interface Props {
  id: string;
  label: string;
  viewAllHref: string;
  viewAllLabel: string;
  stretchCards?: boolean;
}

const {
  id,
  label,
  viewAllHref,
  viewAllLabel,
  stretchCards = true,
} = Astro.props;
---

<div
  class:list={['carousel', { 'carousel--stretch-cards': stretchCards }]}
  data-carousel
  data-reveal
>
  <div class="carousel-heading">
    <h2>{label}</h2>
    <div class="carousel-actions">
      <a class="button" href={viewAllHref}>{viewAllLabel}</a>
    </div>
    <div
      class="carousel-controls"
      data-carousel-controls
      aria-label={`${site.ui.carousel.controlsPrefix} ${label}`}
      hidden
    >
      <button type="button" data-carousel-previous aria-controls={id}>
        {site.ui.carousel.previous}
      </button><button type="button" data-carousel-next aria-controls={id}>
        {site.ui.carousel.next}
      </button>
    </div>
  </div><div
    id={id}
    class="carousel-track"
    data-carousel-track
    tabindex="0"
    aria-label={label}
  >
    <slot />
  </div>
</div>

<style>
  .carousel {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }
  .carousel-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.75rem;
  }
  .carousel-heading h2 {
    margin: 0;
  }
  .carousel-actions {
    justify-self: end;
  }
  .carousel-controls {
    grid-column: 1 / -1;
    justify-self: stretch;
  }
  .carousel-controls[hidden] {
    display: none;
  }
  .carousel-controls:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .carousel-controls button {
    min-height: 2rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }
  .carousel-controls button:hover,
  .carousel-controls button:focus-visible {
    background: var(--color-panel);
    color: inherit;
  }
  .carousel-track {
    display: grid;
    grid-auto-columns: minmax(84%, 1fr);
    grid-auto-flow: column;
    gap: var(--space);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track :global(.carousel-item) {
    min-width: 0;
    scroll-snap-align: start;
  }
  .carousel-track :global(.carousel-item > .card .flash-card-meta) {
    margin-bottom: 1.35rem;
  }
  .carousel--stretch-cards .carousel-track :global(.carousel-item > .card) {
    height: 100%;
  }
  .carousel:not(.carousel--stretch-cards)
    .carousel-track
    :global(.carousel-item > .card) {
    padding-bottom: 0;
  }
  @media (min-width: 768px) {
    .carousel-track {
      grid-auto-columns: minmax(20rem, 48%);
    }
  }
  @media (min-width: 1024px) {
    .carousel-track {
      grid-auto-columns: minmax(20rem, 31%);
    }
  }
</style>

<script is:inline type="module" src="/scripts/content-carousel.js"></script>
