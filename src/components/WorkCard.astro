---
import GalleryImage from './GalleryImage.astro';
import site from '../data/site.json';
interface Props {
  work: any;
}
const { work } = Astro.props;
const titleId = `work-card-title-${work.id}`;
---

<article
  class="card card--linked"
  data-work-card
  data-collection={work.data.collection}
  data-status={work.data.status}
>
  <div class="card__content">
    <GalleryImage
      src={work.data.cover}
      alt={work.data.coverAlt}
      sizes={site.ui.imageSizing.card || site.ui.imageSizing.zoomable}
    /><span class="status">{work.data.status}</span><h3 id={titleId}>
      {work.data.title}
    </h3><p>
      {work.data.technique} · {work.data.dimensions}
    </p>{
      work.data.showPrice && work.data.priceEur ? (
        <p>
          <strong>{work.data.priceEur} €</strong>
        </p>
      ) : null
    }<span class="card__cta">{site.ui.artwork.cardCta}</span>
  </div>
  <a class="card__link" href={`/obra/${work.id}/`} aria-labelledby={titleId}
  ></a>
</article>

<style>
  .card--linked {
    position: relative;
  }
  .card__content {
    position: relative;
    z-index: 0;
  }
  .card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card__cta {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .card--linked:hover .card__cta {
    text-decoration-thickness: 2px;
  }
  .card__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
