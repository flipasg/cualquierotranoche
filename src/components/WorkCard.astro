---
import GalleryImage from './GalleryImage.astro';
import site from '../data/site.json';
interface Props {
  work: any;
}
const { work } = Astro.props;
const titleId = `work-card-title-${work.id}`;
const metaId = `work-card-meta-${work.id}`;
const statusId = `work-card-status-${work.id}`;
const priceId = `work-card-price-${work.id}`;
const ctaId = `work-card-cta-${work.id}`;
const descriptionIds = [
  statusId,
  metaId,
  work.data.showPrice && work.data.priceEur ? priceId : null,
  ctaId,
]
  .filter(Boolean)
  .join(' ');
---

<article
  class="card"
  data-work-card
  data-collection={work.data.collection}
  data-status={work.data.status}
>
  <a
    class="card__link"
    href={`/obra/${work.id}/`}
    aria-labelledby={titleId}
    aria-describedby={descriptionIds}
  >
    <GalleryImage
      src={work.data.cover}
      alt={work.data.coverAlt}
      sizes={site.ui.imageSizing.card || site.ui.imageSizing.zoomable}
    /><span id={statusId} class="status">{work.data.status}</span><h3
      id={titleId}
    >
      {work.data.title}
    </h3><p id={metaId}>
      {work.data.technique} · {work.data.dimensions}
    </p>{
      work.data.showPrice && work.data.priceEur ? (
        <p id={priceId}>
          <strong>{work.data.priceEur} €</strong>
        </p>
      ) : null
    }<span id={ctaId} class="card__cta">{site.ui.artwork.cardCta}</span>
  </a>
</article>

<style>
  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card__cta {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .card__link:hover .card__cta,
  .card__link:focus-visible .card__cta {
    text-decoration-thickness: 2px;
  }
</style>
