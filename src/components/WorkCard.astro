---
import GalleryImage from './GalleryImage.astro';
interface Props {
  work: any;
}
const { work } = Astro.props;
---

<article
  class="card"
  data-work-card
  data-collection={work.data.collection}
  data-status={work.data.status}
>
  <a href={`/obra/${work.id}/`}
    ><GalleryImage src={work.data.cover} alt={work.data.coverAlt} /></a
  ><span class="status">{work.data.status}</span><h3>{work.data.title}</h3><p>
    {work.data.technique} · {work.data.dimensions}
  </p>{
    work.data.showPrice && work.data.priceEur ? (
      <p>
        <strong>{work.data.priceEur} €</strong>
      </p>
    ) : null
  }<a href={`/obra/${work.id}/`}>Ver la pieza</a>
</article>
