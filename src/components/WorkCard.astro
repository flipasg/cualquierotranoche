---
import GalleryImage from './GalleryImage.astro';
import { site } from '../data';
import RichText from './RichText.astro';
import { getCollectionSlug } from '../lib/obra-collections';
interface Props {
  work: any;
}
const { work } = Astro.props;
const cardFrame = site.ui.imageSizing.cardFrame ?? {};
const cardStyle = `--card-media-width:${cardFrame.width || '100%'};--card-media-height:${cardFrame.height || 'auto'};`;
const collectionSlug = getCollectionSlug(work.data.collection);
const hasVisiblePrice = work.data.showPrice && work.data.priceEur;
const statusLabel =
  work.data.status === 'disponible'
    ? (site.ui.artwork.statusAvailable ?? 'Disponible')
    : work.data.status === 'reservada'
      ? (site.ui.artwork.statusReserved ?? 'Reservada')
      : work.data.status === 'vendida'
        ? (site.ui.artwork.statusSold ?? 'Vendida')
        : undefined;
const details = [work.data.technique, work.data.dimensions].filter(Boolean);
---

<article
  class="card card--media-sized"
  data-work-card
  data-gallery-card
  data-gallery-taxonomies={work.data.collection ?? ''}
  data-gallery-status={work.data.status}
  data-collection={work.data.collection}
  data-status={work.data.status}
  style={cardStyle}
  data-reveal
>
  <a class="card__link" href={`/obra/${collectionSlug}/${work.id}/`}>
    <GalleryImage
      src={work.data.cover}
      alt=""
      class="work-card__image"
      viewerTitle={work.data.title}
      viewerDescription={work.data.description}
      sizes={site.ui.imageSizing.card || site.ui.imageSizing.default}
    />
    <div class="work-card__body">
      <h3><RichText content={work.data.title} inline /></h3>
      <div class="work-card__details">
        {details.map((detail) => <span>{detail}</span>)}
      </div>
      <div class="work-card__footer">
        <div class="card__meta">
          {statusLabel && <span class="card-status">{statusLabel}</span>}
          {
            hasVisiblePrice && (
              <strong class="card__price">{work.data.priceEur} €</strong>
            )
          }
        </div>
        <span class="card__cta">{site.ui.artwork.cardCta}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card__link {
    align-items: stretch;
  }
  .card__link :global(.work-card__image) {
    display: block;
    align-self: stretch;
    height: auto;
  }
  .work-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 0 1rem 1rem;
  }
  .work-card__body h3 {
    margin: 0.9rem 0 0.4rem;
  }
  .work-card__details {
    display: grid;
    gap: 0.15rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .work-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .card__meta {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.3;
  }
  .card-status {
    color: var(--color-accent);
    font-weight: 600;
  }
  .card__price {
    margin: 0;
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 600;
  }
  .work-card__footer .card__cta {
    align-self: center;
    flex: 0 0 auto;
    width: auto;
    min-height: var(--control-min-height);
    margin: 0;
  }
</style>
