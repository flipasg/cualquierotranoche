---
import { formUrl, type FormParams } from '../config/forms';
import site from '../data/site.json';

interface Props {
  url: string;
  params?: FormParams;
  secondary?: boolean;
  className?: string;
  linkStyle?: boolean;
}

const {
  url,
  params = {},
  secondary = false,
  className,
  linkStyle = false,
} = Astro.props;
const href = formUrl(url, params);
---

{
  href ? (
    <a
      class:list={[
        linkStyle ? 'link-button' : 'button',
        className,
        { secondary },
      ]}
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <slot />
    </a>
  ) : (
    <div class="unavailable">
      <strong>
        <slot />
      </strong>
      <span>{site.ui.forms.unavailable}</span>
    </div>
  )
}

<style>
  .unavailable {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid currentColor;
    border-radius: var(--radius);
  }
  .unavailable span {
    font-size: 0.9rem;
  }
  .link-button {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
</style>
