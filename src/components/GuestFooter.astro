---
import {
  guestDateRange,
  visibleGuests,
  type GuestsConfig,
} from '../lib/guests';

interface Props {
  config: GuestsConfig;
  pathname: string;
}
const { config, pathname } = Astro.props;
const entries = visibleGuests(config.entries);
const show =
  config.showInFooter &&
  pathname.replace(/\/+$/, '') !== '/contacto' &&
  entries.length > 0;
---

{
  show && (
    <section class="footer-guests" aria-labelledby="footer-guests-heading">
      <h2 id="footer-guests-heading">{config.footerHeading}</h2>
      <ul>
        {entries.map((guest) => (
          <li>
            <div class="footer-guest">
              <span class="footer-guest-title">
                <span
                  class="guest-dot"
                  style={{ backgroundColor: guest.color }}
                  aria-hidden="true"
                />
                <span class="guest-city">{guest.city}</span>
                <span class="guest-range">{guestDateRange(guest)}</span>
              </span>
              {guest.studio && <span class="guest-studio">{guest.studio}</span>}
              {guest.address && (
                <span class="guest-address">{guest.address}</span>
              )}
              {guest.description && (
                <span class="guest-description">{guest.description}</span>
              )}
            </div>
            {guest.mapsUrl && (
              <a
                class="guest-map"
                href={guest.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${config.mapsLabel}: ${guest.city}`}
              >
                {config.mapsLabel}
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .footer-guests {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  h2 {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li {
    border-top: 1px solid var(--color-border);
  }
  .footer-guest {
    display: block;
    padding: 0.7rem 0;
    text-decoration: none;
    font-size: 0.9rem;
    color: inherit;
  }
  .guest-city {
    color: inherit;
  }
  .footer-guest-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }
  .guest-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
    align-self: center;
  }
  .guest-range {
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-left: auto;
  }
  .guest-studio,
  .guest-address,
  .guest-description {
    display: block;
    font-size: 0.8rem;
    margin-top: 0.2rem;
    padding-left: 1.05rem;
  }
  .guest-description,
  .guest-address {
    white-space: pre-line;
  }
  .guest-map {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: 1.05rem;
    font-size: 0.8rem;
    text-underline-offset: 0.25em;
  }
  .guest-map:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }
</style>
