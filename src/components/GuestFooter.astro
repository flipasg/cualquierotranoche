---
import {
  guestDateRange,
  visibleGuests,
  type GuestsConfig,
} from '../lib/guests';

interface Props {
  config: GuestsConfig;
  pathname: string;
}
const { config, pathname } = Astro.props;
const entries = visibleGuests(config.entries);
const limit = 3;
const show =
  config.showInFooter &&
  pathname.replace(/\/+$/, '') !== '/contacto' &&
  entries.length > 0;
---

{
  show && (
    <section
      class="footer-guests"
      aria-labelledby="footer-guests-heading"
      data-guest-list
      data-guest-limit={limit}
    >
      <h2 id="footer-guests-heading">{config.footerHeading}</h2>
      <ul>
        {entries.map((guest, index) => (
          <li data-guest-end={guest.endDate} hidden={index >= limit}>
            <div class="footer-guest">
              <span class="footer-guest-title">
                <span
                  class="guest-dot"
                  style={{ backgroundColor: guest.color }}
                  aria-hidden="true"
                />
                <span class="guest-city">{guest.city}</span>
                <span class="guest-range">{guestDateRange(guest)}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .footer-guests {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  h2 {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li {
    border-top: 1px solid var(--color-border);
  }
  .footer-guest {
    display: block;
    padding: 0.7rem 0;
    text-decoration: none;
    font-size: 0.9rem;
    color: inherit;
  }
  .guest-city {
    color: inherit;
  }
  .footer-guest-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }
  .guest-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
    align-self: center;
  }
  .guest-range {
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-left: auto;
  }
</style>
