---
import { forms } from '../config/forms';
import { guestDateLabels, guestDateRange, type Guest } from '../lib/guests';
import TallyLink from './TallyLink.astro';

interface Props {
  guest: Guest;
  inquiryLabel: string;
  mapsLabel: string;
  hidden?: boolean;
}

const { guest, inquiryLabel, mapsLabel, hidden = false } = Astro.props;
const date = guestDateLabels(guest);
const spansMonths = guest.startDate.slice(0, 7) !== guest.endDate.slice(0, 7);
const hasDetails = Boolean(guest.address || guest.mapsUrl || guest.description);
---

<li
  id={`guest-${guest.id}`}
  class="guest-event guest-card"
  data-guest-end={guest.endDate}
  hidden={hidden}
>
  <time
    datetime={guest.startDate}
    class:list={['guest-card-date', { 'guest-card-date--long': spansMonths }]}
    aria-label={guestDateRange(guest)}
  >
    <span class="guest-card-date-wide" aria-hidden="true">
      <span class="guest-card-month">{date.month}</span>
      <span class="guest-card-days">{date.days}</span>
      <span class="guest-card-weekdays">{date.weekdays}</span>
    </span>
    <span class="guest-card-date-compact" aria-hidden="true">
      {date.compact}
    </span>
  </time>
  <div class="guest-card-info">
    <h4 class="guest-card-city">{guest.city}</h4>
    {guest.studio && <p class="guest-card-studio">{guest.studio}</p>}
  </div>
  {
    hasDetails && (
      <div class="guest-card-meta">
        {guest.mapsUrl ? (
          <a
            class="guest-card-map"
            href={guest.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${mapsLabel}: ${guest.address || guest.city}`}
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            <span>{guest.address || mapsLabel}</span>
          </a>
        ) : (
          guest.address && <p class="guest-card-address">{guest.address}</p>
        )}
        {guest.description && (
          <p class="guest-card-description">{guest.description}</p>
        )}
      </div>
    )
  }
  <div class="guest-card-actions">
    <TallyLink
      url={forms.tattoo}
      params={{ source: `portfolio-guest-${guest.id}` }}
      className="guest-card-inquiry"
    >
      {inquiryLabel}
      <span class="sr-only">: {guest.city}, {guestDateRange(guest)}</span>
    </TallyLink>
  </div>
</li>

<style>
  .guest-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1rem, 2.5cqi, 1.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    scroll-margin-top: 8rem;
  }
  .guest-card > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .guest-card[hidden] {
    display: none;
  }
  .guest-card-date {
    color: var(--color-accent);
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .guest-card-date-wide {
    display: none;
  }
  .guest-card-date-compact {
    font-size: 0.95rem;
  }
  .guest-card-city {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .guest-card-studio {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .guest-card-map,
  .guest-card-address,
  .guest-card-description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: pre-line;
  }
  .guest-card-meta > * + * {
    margin-top: 0.75rem;
  }
  .guest-card-map span,
  .guest-card-address {
    white-space: normal;
  }
  .guest-card-map {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    max-width: 100%;
    color: var(--color-link);
    text-decoration: none;
  }
  .guest-card-map svg {
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
  }
  .guest-card-map span {
    min-width: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .guest-card-description {
    color: var(--color-muted);
  }
  .guest-card-actions {
    margin-top: 0.25rem;
  }
  .guest-card-actions :global(.guest-card-inquiry) {
    width: auto;
    min-height: var(--control-min-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    font-size: var(--control-font-size);
    font-weight: 500;
    text-align: center;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (min-width: 900px) {
    @container (width < 34rem) {
      .guest-card {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        padding: 1rem;
      }
      .guest-card-date,
      .guest-card-meta {
        grid-column: 1 / -1;
      }
      .guest-card-info {
        grid-column: 1;
        grid-row: 2;
        align-self: center;
      }
      .guest-card-actions {
        grid-column: 2;
        grid-row: 2;
        align-self: center;
        margin: 0;
      }
    }
  }
  @container (min-width: 34rem) {
    .guest-card {
      grid-template-columns: minmax(10rem, max-content) minmax(0, 1fr) auto;
      grid-template-rows: auto;
      align-items: start;
      gap: 1rem;
    }
    .guest-card:has(.guest-card-meta) {
      grid-template-rows: auto auto;
    }
    .guest-card-date {
      display: flex;
      flex-direction: column;
      grid-column: 1;
      grid-row: 1 / -1;
      align-self: stretch;
      padding-right: 1rem;
      border-right: 1px solid var(--color-border);
    }
    .guest-card-info {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
    }
    .guest-card-meta {
      grid-column: 2 / -1;
      grid-row: 2;
    }
    .guest-card-date-wide {
      display: grid;
      flex: 1;
      align-content: start;
      gap: 1rem;
    }
    .guest-card-date-compact {
      display: none;
    }
    .guest-card-month,
    .guest-card-weekdays {
      color: var(--color-text);
      font-size: 0.75rem;
      letter-spacing: 0.025em;
    }
    .guest-card-month {
      white-space: nowrap;
    }
    .guest-card-days {
      font-size: 1.5rem;
      font-weight: 400;
      line-height: 1;
      white-space: nowrap;
    }
    .guest-card-date--long .guest-card-days {
      font-size: 1rem;
      white-space: normal;
    }
    .guest-card-actions {
      grid-column: 3;
      grid-row: 1;
      align-self: center;
      margin: 0;
    }
  }
</style>
