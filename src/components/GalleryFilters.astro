---
import GalleryImage from './GalleryImage.astro';

interface Taxonomy {
  id: string;
  label: string;
  count: number;
  featured?: boolean;
  image?: string;
  imageAlt?: string;
}

interface Status {
  id: string;
  label: string;
  count: number;
}

interface Props {
  taxonomyLabel: string;
  taxonomyAllLabel: string;
  featuredLabel: string;
  statusLabel?: string;
  activeLabel?: string;
  clearLabel?: string;
  showStatusCounts?: boolean;
  showCategoryCounts?: boolean;
  showActiveFilters?: boolean;
  showClearButton?: boolean;
  showTaxonomySearch?: boolean;
  taxonomySearchLabel?: string;
  showGlobalSearch?: boolean;
  globalSearchLabel?: string;
  globalSearchPlaceholder?: string;
  searchParam?: string;
  itemLabel: string;
  emptyLabel: string;
  urlParam: string;
  defaultStatus?: string;
  statuses: Status[];
  taxonomies: Taxonomy[];
}

const {
  taxonomyLabel,
  taxonomyAllLabel,
  featuredLabel,
  statusLabel = '',
  activeLabel,
  clearLabel = 'Limpiar',
  showStatusCounts = false,
  showCategoryCounts = false,
  showActiveFilters = true,
  showClearButton = true,
  showTaxonomySearch = true,
  taxonomySearchLabel = 'Buscar categorías',
  showGlobalSearch = true,
  globalSearchLabel = '',
  globalSearchPlaceholder = 'Buscar por título',
  searchParam = 'search',
  itemLabel,
  emptyLabel,
  urlParam,
  defaultStatus = 'all',
  statuses,
  taxonomies,
} = Astro.props;
const featured = taxonomies.filter((taxonomy) => taxonomy.featured);
---

<div
  class="gallery-filter-root"
  data-global-search-enabled={showGlobalSearch}
  data-gallery-search-param={showGlobalSearch ? searchParam : ''}
>
  {
    showGlobalSearch && (
      <label class="gallery-global-search">
        {globalSearchLabel && <span>{globalSearchLabel}</span>}
        <input
          type="search"
          data-gallery-search
          placeholder={globalSearchPlaceholder}
          aria-label={
            globalSearchLabel || globalSearchPlaceholder || 'Buscar por título'
          }
        />
      </label>
    )
  }
  <div class="gallery-filter-actions">
    <details
      class="gallery-filters"
      data-gallery-filter-panel
      data-gallery-default-status={defaultStatus}
      open
    >
      <summary data-gallery-filter-summary>Filtros</summary>
      <div
        class:list={[
          'gallery-filter-controls',
          { 'gallery-filter-controls--taxonomy': taxonomies.length > 0 },
        ]}
      >
        <div
          class="gallery-filter-group"
          role="group"
          aria-label={statusLabel || 'Estado'}
        >
          {
            statusLabel && (
              <strong class="gallery-filter-label">{statusLabel}</strong>
            )
          }
          <div
            class="gallery-filter-statuses"
            role="group"
            aria-label={statusLabel || 'Estado'}
          >
            {
              statuses.map((status) => (
                <button
                  type="button"
                  data-gallery-status={status.id}
                  aria-pressed={status.id === defaultStatus ? 'true' : 'false'}
                >
                  {status.label}
                  {showStatusCounts && (
                    <>
                      {' '}
                      <span>({status.count})</span>
                    </>
                  )}
                </button>
              ))
            }
          </div>
        </div>
        {
          taxonomies.length > 0 && (
            <div class="gallery-filter-group gallery-filter-taxonomy">
              {taxonomyLabel && (
                <strong class="gallery-filter-label">{taxonomyLabel}</strong>
              )}
              <details data-gallery-taxonomy-select>
                <summary data-gallery-taxonomy-summary>
                  <span data-gallery-taxonomy-summary-label>
                    {taxonomyAllLabel}
                  </span>
                </summary>
                <div class="gallery-taxonomy-options">
                  {showTaxonomySearch && (
                    <label class="gallery-taxonomy-search">
                      <input
                        type="search"
                        data-gallery-taxonomy-search
                        placeholder={taxonomySearchLabel}
                        aria-label={taxonomySearchLabel || 'Buscar categorías'}
                      />
                    </label>
                  )}
                  <label class="gallery-taxonomy-all">
                    <input type="checkbox" data-gallery-taxonomy-all checked />
                    {taxonomyAllLabel}
                  </label>
                  <fieldset data-gallery-taxonomy-selected-section hidden>
                    <legend>Seleccionadas</legend>
                    <div data-gallery-taxonomy-selected />
                  </fieldset>
                  <fieldset>
                    <legend>Sin seleccionar</legend>
                    <div data-gallery-taxonomy-unselected>
                      {taxonomies.map((taxonomy) => (
                        <label data-gallery-taxonomy-row>
                          <input
                            type="checkbox"
                            value={taxonomy.id}
                            data-gallery-taxonomy-option
                          />
                          {taxonomy.label}
                          {showCategoryCounts && (
                            <>
                              {' '}
                              <span>({taxonomy.count})</span>
                            </>
                          )}
                        </label>
                      ))}
                    </div>
                  </fieldset>
                </div>
              </details>
            </div>
          )
        }
        {
          showClearButton && !showActiveFilters && (
            <button
              type="button"
              class="gallery-filter-clear gallery-filter-clear--desktop"
              data-gallery-clear
              hidden
            >
              {clearLabel}
            </button>
          )
        }
      </div>
    </details>
    {
      showClearButton && !showActiveFilters && (
        <button
          type="button"
          class="gallery-filter-clear gallery-filter-clear--mobile"
          data-gallery-clear
          hidden
        >
          {clearLabel}
        </button>
      )
    }
  </div>
</div>

{
  featured.length > 0 && (
    <section class="gallery-featured" aria-label={featuredLabel}>
      <div class="gallery-featured__list">
        {featured.map((taxonomy) => (
          <button
            type="button"
            class="gallery-featured__card"
            data-gallery-featured={taxonomy.id}
            aria-pressed="false"
          >
            {taxonomy.image && (
              <span class="gallery-featured__media">
                <GalleryImage
                  src={taxonomy.image}
                  alt={taxonomy.imageAlt ?? ''}
                  sizes="96px"
                  class="gallery-featured__image"
                />
              </span>
            )}
            <span>
              <strong>{taxonomy.label}</strong>
              {showCategoryCounts && (
                <small>
                  {taxonomy.count} {itemLabel}
                </small>
              )}
            </span>
          </button>
        ))}
      </div>
    </section>
  )
}

{
  showActiveFilters && (
    <div class="gallery-filter-summary" data-gallery-taxonomy-param={urlParam}>
      <div data-gallery-active-filters hidden>
        {activeLabel && (
          <strong class="gallery-active-label">{activeLabel}</strong>
        )}
        <button
          type="button"
          class="gallery-applied-toggle"
          data-gallery-applied-toggle
          aria-expanded="false"
        >
          <>
            <span>{activeLabel || 'Filtros aplicados'}</span>
            <span class="gallery-applied-chevron" aria-hidden="true" />
          </>
        </button>
        {showClearButton && (
          <button
            type="button"
            class="gallery-filter-clear gallery-filter-clear--mobile"
            data-gallery-clear
            hidden
          >
            {clearLabel}
          </button>
        )}
        <span data-gallery-filter-chips />
        {showClearButton && (
          <button
            type="button"
            class="gallery-filter-clear gallery-filter-clear--desktop"
            data-gallery-clear
            hidden
          >
            {clearLabel}
          </button>
        )}
      </div>
    </div>
  )
}
<p data-gallery-empty hidden>{emptyLabel}</p>

<style>
  .gallery-filter-root {
    --gallery-filter-divider-gap: clamp(1rem, 2vw, 2rem);
    gap: var(--gallery-filter-divider-gap);
    margin-top: 2rem;
    width: 100%;
  }
  .gallery-global-search {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 28rem;
    margin-bottom: 1.25rem;
  }
  .gallery-global-search input,
  .gallery-taxonomy-search input {
    width: 100%;
    min-height: 48px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: transparent;
    color: inherit;
    font: inherit;
    padding: 0.65rem 0.85rem;
  }
  .gallery-global-search input {
    padding: 0.75rem 1rem;
  }
  .gallery-global-search input:focus-visible,
  .gallery-taxonomy-search input:focus,
  .gallery-taxonomy-search input:focus-visible {
    outline: 0 !important;
    outline-offset: 0;
    box-shadow: none;
  }
  .gallery-filter-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    .gallery-filter-root {
      display: flex;
      align-items: center;
    }
    .gallery-global-search {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
      max-width: none;
      margin: 0;
    }
    .gallery-filter-actions {
      flex: 1.5 1 0;
      border-left: 1px solid
        color-mix(in srgb, var(--color-accent) 45%, transparent);
      min-width: 0;
      padding-left: var(--gallery-filter-divider-gap);
    }
    .gallery-filters {
      flex: 1 1 0;
      min-width: 0;
    }
  }
  .gallery-filters > summary {
    display: none;
  }
  .gallery-filter-controls {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--gallery-filter-divider-gap);
  }
  .gallery-filter-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }
  .gallery-filter-group[role='group'] {
    flex: 0 1 auto;
  }
  .gallery-filter-label {
    flex: 0 0 auto;
  }
  .gallery-filter-statuses {
    display: flex;
    min-width: 0;
  }
  .gallery-filter-statuses button {
    flex: 0 0 auto;
    width: max-content;
    min-width: max-content;
    min-height: 48px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    cursor: pointer;
    padding: 0.75rem 1rem;
    white-space: nowrap;
    transition:
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }
  .gallery-filter-statuses button + button {
    margin-left: -1px;
  }
  .gallery-filter-statuses button[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .gallery-filter-taxonomy details {
    position: relative;
    flex: 1 1 16rem;
    min-width: 0;
    max-width: none;
  }
  .gallery-filter-taxonomy {
    flex: 1 1 20rem;
    min-width: 0;
    max-width: 100%;
    border-left: 1px solid
      color-mix(in srgb, var(--color-accent) 45%, transparent);
    padding-left: var(--gallery-filter-divider-gap);
  }
  .gallery-filter-taxonomy summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    cursor: pointer;
    padding: 0.75rem 1rem;
  }
  .gallery-filter-taxonomy summary span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-filter-taxonomy summary::-webkit-details-marker {
    display: none;
  }
  .gallery-filter-taxonomy summary::marker {
    content: '';
  }
  .gallery-filter-taxonomy summary::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-0.15rem);
    transition: transform var(--motion-fast) ease;
  }
  .gallery-filter-taxonomy details[open] > summary::after {
    transform: rotate(225deg) translate(-0.1rem, -0.1rem);
  }
  .gallery-taxonomy-options {
    position: absolute;
    z-index: 2;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: var(--color-bg);
    padding: 0.75rem 1rem;
  }
  .gallery-taxonomy-options fieldset {
    min-width: 0;
    border: 0;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .gallery-taxonomy-options legend {
    margin-bottom: 0.35rem;
    font-weight: 700;
  }
  .gallery-taxonomy-options fieldset[hidden] {
    display: none;
  }
  .gallery-taxonomy-search {
    display: block !important;
    margin-bottom: 0.75rem;
  }
  .gallery-taxonomy-options label {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    min-height: 2.4rem;
    cursor: pointer;
  }
  .gallery-taxonomy-options label[hidden] {
    display: none;
  }
  .gallery-taxonomy-options label span {
    margin-left: auto;
  }
  .gallery-taxonomy-options input[type='checkbox'] {
    appearance: none;
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 1.55rem;
    place-content: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 65%, transparent);
    border-radius: 0.2rem;
    background: var(--color-bg);
    cursor: pointer;
  }
  .gallery-taxonomy-options input[type='checkbox']::after {
    content: '';
    width: 0.42rem;
    height: 0.75rem;
    border: solid var(--color-bg);
    border-width: 0 0.18rem 0.18rem 0;
    transform: rotate(45deg) translate(-0.08rem, -0.08rem);
    opacity: 0;
  }
  .gallery-taxonomy-options input[type='checkbox']:checked {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .gallery-taxonomy-options input[type='checkbox']:checked::after {
    opacity: 1;
  }
  .gallery-taxonomy-options input[type='checkbox']:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .gallery-featured {
    margin-top: 2.25rem;
  }
  .gallery-featured__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .gallery-featured__card {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 80px;
    gap: 10px;
    border: 2px solid transparent;
    background: color-mix(in srgb, var(--color-bg) 30%, white);
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 1rem;
    line-height: 1.25;
    padding: 3px 8px;
    text-align: left;
    transition:
      border-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }
  .gallery-featured__card[aria-pressed='true'] {
    border-color: var(--color-accent);
  }
  .gallery-featured__card:hover,
  .gallery-featured__card:focus-visible {
    border-color: var(--color-accent);
  }
  .gallery-featured__card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .gallery-featured__media {
    width: min(75px, 38%);
    flex: 0 0 min(75px, 38%);
    aspect-ratio: 15 / 14;
    overflow: hidden;
  }
  .gallery-featured__card :global(.gallery-featured__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transform: scale(1.25);
    transform-origin: center 20%;
  }
  .gallery-featured__card span,
  .gallery-featured__card small {
    display: block;
  }
  .gallery-featured__card span {
    min-width: 0;
  }
  .gallery-featured__card strong {
    font-weight: 600;
  }
  .gallery-featured__card small {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  @media (min-width: 1024px) {
    .gallery-featured__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 1196px;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .gallery-featured__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 592px;
    }
  }
  @media (max-width: 1023px) {
    .gallery-featured__card {
      font-size: 0.875rem;
    }
    .gallery-featured__card small {
      font-size: 0.75rem;
    }
  }
  .gallery-filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-accent) 30%, transparent);
    margin: 2rem 0 clamp(1.5rem, 4vw, 3rem);
    padding-top: 1.5rem;
  }
  .gallery-filter-summary > div,
  [data-gallery-filter-chips] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .gallery-filter-summary > [data-gallery-active-filters] {
    width: 100%;
  }
  .gallery-filter-clear--desktop {
    margin-left: auto;
  }
  .gallery-filter-clear--mobile {
    display: none;
  }
  [data-gallery-filter-chips][hidden] {
    display: none;
  }
  .gallery-filter-summary > div[hidden] {
    display: none;
  }
  .gallery-applied-toggle {
    display: none;
  }
  :global([data-gallery-filter-chips] button) {
    min-height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0.5rem 1rem;
  }
  .link-button {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
  }
  .gallery-filter-clear {
    min-height: 48px;
    border: 1px solid var(--color-accent);
    border-radius: 0;
    background: transparent;
    color: var(--color-accent);
    cursor: pointer;
    font: inherit;
    padding: 0.75rem 1rem;
  }
  .gallery-filter-clear[hidden] {
    display: none;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .gallery-filter-root {
      --gallery-filter-divider-gap: 0.5rem;
    }
    .gallery-filter-controls {
      gap: 0.5rem;
    }
    .gallery-filter-group {
      gap: 0.5rem;
    }
    .gallery-filter-taxonomy {
      flex-basis: 14rem;
      padding-left: 0.5rem;
    }
    .gallery-filter-taxonomy summary {
      gap: 1rem;
      padding-inline: 0.75rem;
    }
    .gallery-filter-statuses button {
      padding-inline: 0.5rem;
      font-size: 0.9rem;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .gallery-filter-root {
      width: 100%;
      max-width: 100%;
    }
    .gallery-global-search,
    .gallery-filter-actions {
      width: 100%;
      max-width: none;
    }
    .gallery-filters {
      flex: 1 1 100%;
      width: 100%;
    }
    .gallery-filter-controls {
      width: 100%;
    }
  }
  .gallery-global-search input,
  .gallery-filter-statuses button,
  .gallery-filter-taxonomy summary {
    height: 48px;
    min-height: 48px;
    padding-block: 0;
  }
  @media (max-width: 767px) {
    .gallery-global-search {
      max-width: none;
    }
    .gallery-filters {
      flex: 1 1 100%;
      width: 100%;
    }
    .gallery-filter-actions {
      align-items: stretch;
      justify-content: flex-start;
      width: 100%;
    }
    .gallery-filters > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      min-height: 48px;
      margin-left: 0;
      background: var(--color-accent);
      color: var(--color-bg);
      cursor: pointer;
      padding: 0.75rem 1.25rem;
      font-weight: 700;
    }
    .gallery-filters > summary::-webkit-details-marker {
      display: none;
    }
    .gallery-filters > summary::marker {
      content: '';
    }
    .gallery-filters > summary::after {
      content: '';
      width: 0.55rem;
      height: 0.55rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-0.15rem);
    }
    .gallery-filters[open] > summary {
      width: 100%;
      margin: 0 0 1.25rem;
    }
    .gallery-filters[open] > summary::after {
      transform: rotate(225deg) translate(-0.1rem, -0.1rem);
    }
    .gallery-filter-controls {
      display: block;
      width: 100%;
    }
    .gallery-filter-group {
      display: block;
      width: 100%;
    }
    .gallery-filter-statuses,
    .gallery-filter-taxonomy,
    .gallery-filter-taxonomy details {
      width: 100%;
    }
    .gallery-filter-label {
      display: block;
      margin-bottom: 0.65rem;
    }
    .gallery-filter-taxonomy {
      border-left: 0;
      padding-left: 0;
    }
    .gallery-filter-taxonomy details {
      width: 100%;
      max-width: none;
    }
    .gallery-filter-group + .gallery-filter-group {
      margin-top: 1.25rem;
    }
    .gallery-filter-statuses button {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
      padding-inline: 0.45rem;
    }
    .gallery-filter-taxonomy summary {
      min-width: 0;
    }
    .gallery-taxonomy-options {
      position: static;
    }
    .gallery-filter-summary {
      border-top: 0;
      flex-wrap: wrap;
      margin: 1rem 0 1.5rem;
      padding-top: 0;
    }
    .gallery-filter-summary > div {
      align-items: flex-start;
    }
    .gallery-filter-summary > [data-gallery-active-filters] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .gallery-active-label {
      display: none;
    }
    .gallery-applied-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: auto;
      min-height: 2.75rem;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      padding: 0;
      text-align: left;
    }
    [data-gallery-filter-chips] {
      grid-column: 1 / -1;
    }
    .gallery-filter-clear--mobile {
      grid-column: 2;
    }
    .gallery-applied-chevron {
      width: 0.55rem;
      height: 0.55rem;
      flex: 0 0 0.55rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(225deg) translate(-0.1rem, -0.1rem);
    }
    .gallery-applied-toggle[aria-expanded='true'] .gallery-applied-chevron {
      transform: rotate(45deg) translateY(-0.15rem);
    }
    .gallery-filter-clear {
      padding-inline: 0.85rem;
    }
    .gallery-filter-clear--desktop {
      display: none;
    }
    .gallery-filter-clear--mobile {
      display: inline-block;
    }
  }
</style>
