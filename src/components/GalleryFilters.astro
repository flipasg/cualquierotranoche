---
import GalleryImage from './GalleryImage.astro';
import ModalCloseButton from './ModalCloseButton.astro';

interface Taxonomy {
  id: string;
  label: string;
  count: number;
  featured?: boolean;
  image?: string;
  imageAlt?: string;
}

interface Status {
  id: string;
  label: string;
  count: number;
}

interface Props {
  taxonomyLabel: string;
  taxonomyAllLabel: string;
  featuredLabel: string;
  statusLabel?: string;
  activeLabel?: string;
  clearLabel?: string;
  filterLabel?: string;
  applyLabel?: string;
  closeLabel?: string;
  showStatusCounts?: boolean;
  showCategoryCounts?: boolean;
  showResultCount?: boolean;
  showActiveFilters?: boolean;
  showClearButton?: boolean;
  showTaxonomySearch?: boolean;
  taxonomySearchLabel?: string;
  showGlobalSearch?: boolean;
  globalSearchLabel?: string;
  globalSearchPlaceholder?: string;
  searchParam?: string;
  itemLabel: string;
  emptyLabel: string;
  urlParam: string;
  defaultStatus?: string;
  statuses: Status[];
  taxonomies: Taxonomy[];
}

const {
  taxonomyLabel,
  taxonomyAllLabel,
  featuredLabel,
  statusLabel = '',
  activeLabel,
  clearLabel = 'Limpiar',
  filterLabel = 'Filtros',
  applyLabel = 'Aplicar',
  closeLabel = 'Cerrar',
  showStatusCounts = false,
  showCategoryCounts = false,
  showResultCount = true,
  showActiveFilters = true,
  showClearButton = true,
  showTaxonomySearch = true,
  taxonomySearchLabel = 'Buscar categorías',
  showGlobalSearch = true,
  globalSearchLabel = '',
  globalSearchPlaceholder = 'Buscar por título',
  searchParam = 'search',
  itemLabel,
  emptyLabel,
  urlParam,
  defaultStatus = 'all',
  statuses,
  taxonomies,
} = Astro.props;
const featured = taxonomies.filter((taxonomy) => taxonomy.featured);
const dialogId = `gallery-filters-${urlParam}`;
const filterText = filterLabel?.trim() || 'Filtros';
const applyText = applyLabel?.trim() || 'Aplicar';
const closeText = closeLabel?.trim() || 'Cerrar';
---

<div
  class="gallery-filter-root"
  data-global-search-enabled={showGlobalSearch}
  data-gallery-search-param={showGlobalSearch ? searchParam : ''}
  data-gallery-item-label={itemLabel}
>
  {
    showGlobalSearch && (
      <label class="gallery-global-search">
        {globalSearchLabel && <span>{globalSearchLabel}</span>}
        <input
          type="search"
          data-gallery-search
          placeholder={globalSearchPlaceholder}
          aria-label={
            globalSearchLabel || globalSearchPlaceholder || 'Buscar por título'
          }
        />
      </label>
    )
  }
  <div class="gallery-filter-actions">
    <button
      type="button"
      class="gallery-filter-open"
      data-gallery-filter-summary
      data-filter-label={filterText}
      aria-haspopup="dialog"
      aria-controls={dialogId}
      hidden>{filterText}</button
    >
    <details
      class="gallery-filters"
      data-gallery-filter-panel
      data-gallery-default-status={defaultStatus}
      open
    >
      <summary>{filterText}</summary>
      <div
        data-gallery-filter-controls
        class:list={[
          'gallery-filter-controls',
          { 'gallery-filter-controls--taxonomy': taxonomies.length > 0 },
        ]}
      >
        <div
          class="gallery-filter-group"
          role="group"
          aria-label={statusLabel || 'Estado'}
        >
          {
            statusLabel && (
              <strong class="gallery-filter-label">{statusLabel}</strong>
            )
          }
          <div
            class="gallery-filter-statuses"
            role="group"
            aria-label={statusLabel || 'Estado'}
          >
            {
              statuses.map((status) => (
                <button
                  type="button"
                  data-gallery-status={status.id}
                  aria-pressed={status.id === defaultStatus ? 'true' : 'false'}
                >
                  {status.label}
                  {showStatusCounts && (
                    <>
                      {' '}
                      <span>({status.count})</span>
                    </>
                  )}
                </button>
              ))
            }
          </div>
        </div>
        {
          taxonomies.length > 0 && (
            <div class="gallery-filter-group gallery-filter-taxonomy">
              {taxonomyLabel && (
                <strong class="gallery-filter-label">{taxonomyLabel}</strong>
              )}
              <details data-gallery-taxonomy-select>
                <summary data-gallery-taxonomy-summary>
                  <span data-gallery-taxonomy-summary-label>
                    {taxonomyAllLabel}
                  </span>
                </summary>
                <div class="gallery-taxonomy-options">
                  {showTaxonomySearch && (
                    <label class="gallery-taxonomy-search">
                      <input
                        type="search"
                        data-gallery-taxonomy-search
                        placeholder={taxonomySearchLabel}
                        aria-label={taxonomySearchLabel || 'Buscar categorías'}
                      />
                    </label>
                  )}
                  <label class="gallery-taxonomy-all">
                    <input type="checkbox" data-gallery-taxonomy-all checked />
                    {taxonomyAllLabel}
                  </label>
                  <div
                    class="gallery-taxonomy-list"
                    data-gallery-taxonomy-scroll
                  >
                    <fieldset data-gallery-taxonomy-selected-section hidden>
                      <legend>Seleccionadas</legend>
                      <div data-gallery-taxonomy-selected />
                    </fieldset>
                    <fieldset>
                      <legend>Sin seleccionar</legend>
                      <div data-gallery-taxonomy-unselected>
                        {taxonomies.map((taxonomy) => (
                          <label data-gallery-taxonomy-row>
                            <input
                              type="checkbox"
                              value={taxonomy.id}
                              data-gallery-taxonomy-option
                            />
                            {taxonomy.label}
                            {showCategoryCounts && (
                              <>
                                {' '}
                                <span>({taxonomy.count})</span>
                              </>
                            )}
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  </div>
                </div>
              </details>
            </div>
          )
        }
        {
          showClearButton && !showActiveFilters && (
            <button
              type="button"
              class="gallery-filter-clear gallery-filter-clear--desktop"
              data-gallery-clear
              hidden
            >
              {clearLabel}
            </button>
          )
        }
      </div>
    </details>
    <dialog
      id={dialogId}
      class="gallery-filter-dialog modal-shell"
      data-gallery-filter-dialog
      aria-labelledby={`${dialogId}-title`}
    >
      <div class="gallery-filter-dialog__layout modal-shell__layout">
        <header class="gallery-filter-dialog__header modal-shell__header">
          <h2 id={`${dialogId}-title`} data-gallery-dialog-title tabindex="-1">
            {filterText}
          </h2>
          <ModalCloseButton
            gallery
            className="gallery-filter-close"
            label={closeText}
          />
        </header>
        <div class="gallery-filter-dialog__body" data-gallery-dialog-body></div>
        <footer class="gallery-filter-dialog__footer modal-shell__footer">
          {
            showClearButton && (
              <button
                type="button"
                class="gallery-filter-clear"
                data-gallery-clear
                hidden
              >
                {clearLabel}
              </button>
            )
          }
          <button type="button" class="gallery-filter-apply" data-gallery-apply
            >{applyText}</button
          >
        </footer>
      </div>
    </dialog>
    {
      showClearButton && !showActiveFilters && (
        <button
          type="button"
          class="gallery-filter-clear gallery-filter-clear--mobile"
          data-gallery-clear
          hidden
        >
          {clearLabel}
        </button>
      )
    }
  </div>
</div>

{
  featured.length > 0 && (
    <section class="gallery-featured" aria-label={featuredLabel}>
      <div class="gallery-featured__list">
        {featured.map((taxonomy) => (
          <button
            type="button"
            class="gallery-featured__card"
            data-gallery-featured={taxonomy.id}
            aria-pressed="false"
          >
            {taxonomy.image && (
              <span class="gallery-featured__media">
                <GalleryImage
                  src={taxonomy.image}
                  alt={taxonomy.imageAlt ?? ''}
                  sizes="64px"
                  class="gallery-featured__image"
                />
              </span>
            )}
            <span class="gallery-featured__copy">
              <strong>{taxonomy.label}</strong>
              {showCategoryCounts && (
                <small>
                  {taxonomy.count} {itemLabel}
                </small>
              )}
            </span>
          </button>
        ))}
      </div>
    </section>
  )
}

{
  showActiveFilters && (
    <div class="gallery-filter-summary" data-gallery-taxonomy-param={urlParam}>
      <div data-gallery-active-filters hidden>
        {activeLabel && (
          <strong class="gallery-active-label">{activeLabel}</strong>
        )}
        <button
          type="button"
          class="gallery-applied-toggle"
          data-gallery-applied-toggle
          aria-expanded="false"
        >
          <>
            <span>{activeLabel || 'Filtros aplicados'}</span>
            <span class="gallery-applied-chevron" aria-hidden="true" />
          </>
        </button>
        {showClearButton && (
          <button
            type="button"
            class="gallery-filter-clear gallery-filter-clear--mobile"
            data-gallery-clear
            hidden
          >
            {clearLabel}
          </button>
        )}
        <span data-gallery-filter-chips />
        {showClearButton && (
          <button
            type="button"
            class="gallery-filter-clear gallery-filter-clear--desktop"
            data-gallery-clear
            hidden
          >
            {clearLabel}
          </button>
        )}
      </div>
    </div>
  )
}
{
  showResultCount && (
    <p
      class="gallery-result-count"
      data-gallery-result-count
      aria-live="polite"
    />
  )
}
<p data-gallery-empty data-empty-message={emptyLabel} hidden>{emptyLabel}</p>

<style>
  .gallery-filter-root {
    --gallery-filter-divider-gap: clamp(1rem, 2vw, 2rem);
    gap: var(--gallery-filter-divider-gap);
    margin-top: 2rem;
    width: 100%;
  }
  .gallery-taxonomy-list[data-can-scroll='true']::after {
    position: sticky;
    bottom: 0;
    display: block;
    height: 1.75rem;
    margin-top: -1.75rem;
    background: linear-gradient(transparent, var(--color-surface) 78%);
    color: var(--color-filter);
    content: '⌄';
    font-size: 1.1rem;
    line-height: 1.35rem;
    text-align: center;
    pointer-events: none;
  }
  .gallery-taxonomy-list[data-at-bottom='true']::after {
    display: none;
  }
  .gallery-result-count {
    margin: 1rem 0;
    color: var(--color-accent);
    font-size: 0.85rem;
  }
  [data-gallery-empty] {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gallery-global-search {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 28rem;
    margin-bottom: 1.25rem;
  }
  .gallery-global-search input,
  .gallery-taxonomy-search input {
    width: 100%;
    min-height: var(--control-min-height);
    border: 1px solid color-mix(in srgb, var(--color-filter) 45%, transparent);
    background: var(--color-surface);
    color: inherit;
    font: inherit;
    padding: 0.65rem 0.85rem;
  }
  .gallery-global-search > span {
    color: var(--color-filter);
  }
  .gallery-global-search input {
    padding: 0.5rem 0.75rem;
    font-size: var(--control-font-size);
  }
  .gallery-global-search input:focus-visible,
  .gallery-taxonomy-search input:focus,
  .gallery-taxonomy-search input:focus-visible {
    outline: none;
  }
  .gallery-filter-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    .gallery-filter-root {
      display: flex;
      align-items: center;
    }
    .gallery-global-search {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
      max-width: none;
      margin: 0;
    }
    .gallery-filter-actions {
      flex: 1.5 1 0;
      border-left: 1px solid
        color-mix(in srgb, var(--color-filter) 45%, transparent);
      min-width: 0;
      padding-left: var(--gallery-filter-divider-gap);
    }
    .gallery-filters {
      flex: 1 1 0;
      min-width: 0;
    }
  }
  .gallery-filters > summary {
    display: none;
  }
  [data-gallery-dialog-title]:focus {
    outline: none;
  }
  .gallery-filter-controls {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--gallery-filter-divider-gap);
  }
  .gallery-filter-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }
  .gallery-filter-group[role='group'] {
    flex: 0 1 auto;
  }
  .gallery-filter-label {
    color: var(--color-filter);
    flex: 0 0 auto;
  }
  .gallery-filter-statuses {
    display: flex;
    min-width: 0;
  }
  .gallery-filter-statuses button {
    flex: 0 0 auto;
    width: max-content;
    min-width: max-content;
    min-height: var(--control-min-height);
    border: 1px solid color-mix(in srgb, var(--color-filter) 45%, transparent);
    border-radius: 0;
    background: var(--color-surface);
    color: var(--color-filter);
    font: inherit;
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    font-size: var(--control-font-size);
    white-space: nowrap;
    transition:
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }
  .gallery-filter-statuses button:not([aria-pressed='true']):hover {
    background: color-mix(
      in srgb,
      var(--color-filter) 8%,
      var(--color-surface)
    );
  }
  .gallery-filter-statuses button[aria-pressed='true']:hover {
    background: color-mix(in srgb, var(--color-filter) 92%, var(--color-text));
  }
  .gallery-filter-statuses button + button {
    margin-left: -1px;
  }
  .gallery-filter-statuses button[aria-pressed='true'] {
    background: var(--color-filter);
    color: var(--color-bg);
  }
  .gallery-filter-taxonomy details {
    position: relative;
    flex: 1 1 16rem;
    min-width: 0;
    max-width: none;
  }
  .gallery-filter-taxonomy {
    flex: 1 1 20rem;
    min-width: 0;
    max-width: 100%;
    border-left: 1px solid
      color-mix(in srgb, var(--color-filter) 45%, transparent);
    padding-left: var(--gallery-filter-divider-gap);
  }
  .gallery-filter-taxonomy summary {
    color: var(--color-filter);
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    min-width: 0;
    min-height: var(--control-min-height);
    border: 1px solid color-mix(in srgb, var(--color-filter) 45%, transparent);
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    font-size: var(--control-font-size);
  }
  .gallery-filter-taxonomy summary span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-filter-taxonomy summary::-webkit-details-marker {
    display: none;
  }
  .gallery-filter-taxonomy summary::marker {
    content: '';
  }
  .gallery-filter-taxonomy summary::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-0.15rem);
    transition: transform var(--motion-fast) ease;
  }
  .gallery-filter-taxonomy details[open] > summary::after {
    transform: rotate(225deg) translate(-0.1rem, -0.1rem);
  }
  .gallery-taxonomy-options {
    color: var(--color-filter);
    position: absolute;
    z-index: 2;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-filter) 45%, transparent);
    background: var(--color-surface);
    box-shadow: var(--shadow-overlay);
    padding: 0.75rem 1rem;
  }
  .gallery-taxonomy-list {
    min-height: 0;
  }
  .gallery-taxonomy-options fieldset {
    min-width: 0;
    border: 0;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .gallery-taxonomy-options legend {
    margin-bottom: 0.35rem;
    font-weight: 700;
  }
  .gallery-taxonomy-options fieldset[hidden] {
    display: none;
  }
  .gallery-taxonomy-search {
    display: block !important;
    margin-bottom: 0.75rem;
  }
  .gallery-taxonomy-options label {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    min-height: 2.4rem;
    cursor: pointer;
  }
  .gallery-taxonomy-options label[hidden] {
    display: none;
  }
  .gallery-taxonomy-options label span {
    margin-left: auto;
  }
  .gallery-taxonomy-options input[type='checkbox'] {
    appearance: none;
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 1.55rem;
    place-content: center;
    border: 1px solid color-mix(in srgb, var(--color-filter) 65%, transparent);
    border-radius: 0.2rem;
    background: var(--color-surface);
    cursor: pointer;
  }
  .gallery-taxonomy-options input[type='checkbox']::after {
    content: '';
    width: 0.42rem;
    height: 0.75rem;
    border: solid var(--color-bg);
    border-width: 0 0.18rem 0.18rem 0;
    transform: rotate(45deg) translate(-0.08rem, -0.08rem);
    opacity: 0;
  }
  .gallery-taxonomy-options input[type='checkbox']:checked {
    border-color: var(--color-filter);
    background: var(--color-filter);
  }
  .gallery-taxonomy-options input[type='checkbox']:checked::after {
    opacity: 1;
  }
  .gallery-taxonomy-options input[type='checkbox']:focus-visible {
    outline: 2px solid var(--color-filter);
    outline-offset: 2px;
  }
  .gallery-featured {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .gallery-featured__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .gallery-featured__card {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 88px;
    gap: 12px;
    border: 1px solid color-mix(in srgb, var(--color-filter) 45%, transparent);
    border-radius: 0;
    background: var(--color-surface);
    color: var(--color-filter);
    cursor: pointer;
    font: inherit;
    font-size: 1rem;
    line-height: 1.25;
    padding: 11px 15px;
    text-align: left;
    transition: background-color var(--motion-fast) ease;
  }
  .gallery-featured__card[aria-pressed='true'] {
    border-color: var(--color-filter);
    background: var(--color-filter);
    color: var(--color-surface);
  }
  .gallery-featured__card:not([aria-pressed='true']):hover {
    background: color-mix(
      in srgb,
      var(--color-filter) 8%,
      var(--color-surface)
    );
  }
  .gallery-featured__card[aria-pressed='true']:hover {
    background: color-mix(in srgb, var(--color-filter) 92%, var(--color-text));
  }
  .gallery-featured__card:focus-visible {
    outline: 2px solid var(--color-filter);
    outline-offset: 4px;
  }
  .gallery-featured__media {
    display: grid;
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    place-items: center;
    overflow: hidden;
    border-radius: calc(var(--radius) / 2);
    background: var(--color-panel);
  }
  .gallery-featured__card :global(.gallery-featured__image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery-featured__copy,
  .gallery-featured__card small {
    display: block;
  }
  .gallery-featured__copy {
    min-width: 0;
  }
  .gallery-featured__card strong {
    font-weight: 400;
  }
  .gallery-featured__card small {
    margin-top: 0.35rem;
    color: inherit;
    font-size: 0.875rem;
  }
  @media (min-width: 1024px) {
    .gallery-featured__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 1196px;
    }
    .gallery-featured {
      margin-bottom: 3rem;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .gallery-featured__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 592px;
    }
  }
  @media (max-width: 1023px) {
    .gallery-featured__card {
      font-size: 0.875rem;
    }
    .gallery-featured__card small {
      font-size: 0.75rem;
    }
  }
  .gallery-featured + .gallery-filter-summary {
    margin-top: 0;
  }
  .gallery-filter-summary {
    color: var(--color-filter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-filter) 30%, transparent);
    margin: 2rem 0 clamp(1.5rem, 4vw, 3rem);
    padding-top: 1.5rem;
  }
  .gallery-filter-apply {
    display: none;
  }
  .gallery-filter-summary > div,
  [data-gallery-filter-chips] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .gallery-filter-summary > [data-gallery-active-filters] {
    width: 100%;
  }
  .gallery-filter-clear--desktop {
    margin-left: auto;
  }
  .gallery-filter-clear--mobile {
    display: none;
  }
  [data-gallery-filter-chips][hidden] {
    display: none;
  }
  .gallery-filter-summary > div[hidden] {
    display: none;
  }
  .gallery-applied-toggle {
    display: none;
  }
  :global([data-gallery-filter-chips] button) {
    min-height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--color-filter) 45%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--color-filter);
    cursor: pointer;
    font: inherit;
    padding: 0.5rem 1rem;
  }
  .link-button {
    border: 0;
    background: transparent;
    color: var(--color-filter);
    cursor: pointer;
    font: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
  }
  .gallery-filter-clear {
    min-height: 44px;
    border: 1px solid var(--color-filter);
    border-radius: 0;
    background: transparent;
    color: var(--color-filter);
    cursor: pointer;
    font: inherit;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }
  .gallery-filter-clear[hidden] {
    display: none;
  }
  .gallery-filter-open,
  .gallery-filter-apply {
    min-height: 44px;
    border: 1px solid var(--color-filter);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    background: var(--color-filter);
    color: var(--color-bg);
  }
  .gallery-filter-open {
    width: auto;
    text-align: center;
  }
  .gallery-filter-open[hidden] {
    display: none;
  }
  .gallery-filter-dialog {
    width: calc(100% - 32px);
    max-width: 36rem;
    height: calc(100dvh - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: hidden;
  }
