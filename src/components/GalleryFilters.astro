---
import GalleryImage from './GalleryImage.astro';

interface Taxonomy {
  id: string;
  label: string;
  count: number;
  featured?: boolean;
  image?: string;
  imageAlt?: string;
}

interface Status {
  id: string;
  label: string;
  count: number;
}

interface Props {
  taxonomyLabel: string;
  taxonomyAllLabel: string;
  featuredLabel: string;
  activeLabel: string;
  clearLabel: string;
  itemLabel: string;
  emptyLabel: string;
  urlParam: string;
  defaultStatus?: string;
  statuses: Status[];
  taxonomies: Taxonomy[];
}

const {
  taxonomyLabel,
  taxonomyAllLabel,
  featuredLabel,
  activeLabel,
  clearLabel,
  itemLabel,
  emptyLabel,
  urlParam,
  defaultStatus = 'all',
  statuses,
  taxonomies,
} = Astro.props;
const featured = taxonomies.filter((taxonomy) => taxonomy.featured);
---

<details
  class="gallery-filters"
  data-gallery-filter-panel
  data-gallery-default-status={defaultStatus}
  open
>
  <summary data-gallery-filter-summary>Filtros</summary>
  <div
    class:list={[
      'gallery-filter-controls',
      { 'gallery-filter-controls--taxonomy': taxonomies.length > 0 },
    ]}
  >
    <div class="gallery-filter-group" role="group" aria-label="Estado">
      <strong class="gallery-filter-label">Estado</strong>
      <div class="gallery-filter-statuses" role="group" aria-label="Estado">
        {
          statuses.map((status) => (
            <button
              type="button"
              data-gallery-status={status.id}
              aria-pressed={status.id === defaultStatus ? 'true' : 'false'}
            >
              {status.label} <span>({status.count})</span>
            </button>
          ))
        }
      </div>
    </div>
    {
      taxonomies.length > 0 && (
        <div class="gallery-filter-group gallery-filter-taxonomy">
          <strong class="gallery-filter-label">{taxonomyLabel}</strong>
          <details data-gallery-taxonomy-select>
            <summary data-gallery-taxonomy-summary>
              <span data-gallery-taxonomy-summary-label>
                {taxonomyAllLabel}
              </span>
            </summary>
            <div class="gallery-taxonomy-options">
              <label>
                <input type="checkbox" data-gallery-taxonomy-all checked />
                {taxonomyAllLabel}
              </label>
              {taxonomies.map((taxonomy) => (
                <label>
                  <input
                    type="checkbox"
                    value={taxonomy.id}
                    data-gallery-taxonomy-option
                  />
                  {taxonomy.label} <span>({taxonomy.count})</span>
                </label>
              ))}
            </div>
          </details>
        </div>
      )
    }
  </div>
</details>

{
  featured.length > 0 && (
    <section class="gallery-featured" aria-label={featuredLabel}>
      <div class="gallery-featured__list">
        {featured.map((taxonomy) => (
          <button
            type="button"
            class="gallery-featured__card"
            data-gallery-featured={taxonomy.id}
            aria-pressed="false"
          >
            {taxonomy.image && (
              <span class="gallery-featured__media">
                <GalleryImage
                  src={taxonomy.image}
                  alt={taxonomy.imageAlt ?? ''}
                  sizes="96px"
                  class="gallery-featured__image"
                />
              </span>
            )}
            <span>
              <strong>{taxonomy.label}</strong>
              <small>
                {taxonomy.count} {itemLabel}
              </small>
            </span>
          </button>
        ))}
      </div>
    </section>
  )
}

<div class="gallery-filter-summary" data-gallery-taxonomy-param={urlParam}>
  <div data-gallery-active-filters hidden>
    <strong>{activeLabel}</strong>
    <span data-gallery-filter-chips></span>
    <button type="button" class="link-button" data-gallery-clear
      >{clearLabel}</button
    >
  </div>
</div>
<p data-gallery-empty hidden>{emptyLabel}</p>

<style>
  .gallery-filters {
    margin-top: 2.5rem;
  }
  .gallery-filters > summary {
    display: none;
  }
  .gallery-filter-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .gallery-filter-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }
  .gallery-filter-label {
    flex: 0 0 auto;
  }
  .gallery-filter-statuses {
    display: flex;
  }
  .gallery-filter-statuses button {
    min-height: 48px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    cursor: pointer;
    padding: 0.75rem 1rem;
  }
  .gallery-filter-statuses button + button {
    margin-left: -1px;
  }
  .gallery-filter-statuses button[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .gallery-filter-taxonomy details {
    position: relative;
    flex: 1 1 16rem;
    min-width: 0;
    max-width: 22rem;
  }
  .gallery-filter-taxonomy {
    flex: 1 1 25rem;
    max-width: 100%;
    border-left: 1px solid
      color-mix(in srgb, var(--color-accent) 45%, transparent);
    padding-left: 2.5rem;
  }
  .gallery-filter-taxonomy summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    cursor: pointer;
    padding: 0.75rem 1rem;
  }
  .gallery-filter-taxonomy summary span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-filter-taxonomy summary::-webkit-details-marker {
    display: none;
  }
  .gallery-filter-taxonomy summary::marker {
    content: '';
  }
  .gallery-filter-taxonomy summary::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-0.15rem);
  }
  .gallery-filter-taxonomy details[open] > summary::after {
    transform: rotate(225deg) translate(-0.1rem, -0.1rem);
  }
  .gallery-taxonomy-options {
    position: absolute;
    z-index: 2;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: var(--color-bg);
    padding: 0.75rem 1rem;
  }
  .gallery-taxonomy-options label {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    min-height: 2.4rem;
    cursor: pointer;
  }
  .gallery-taxonomy-options label span {
    margin-left: auto;
  }
  .gallery-taxonomy-options input[type='checkbox'] {
    appearance: none;
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 1.55rem;
    place-content: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 65%, transparent);
    border-radius: 0.2rem;
    background: var(--color-bg);
    cursor: pointer;
  }
  .gallery-taxonomy-options input[type='checkbox']::after {
    content: '';
    width: 0.42rem;
    height: 0.75rem;
    border: solid var(--color-bg);
    border-width: 0 0.18rem 0.18rem 0;
    transform: rotate(45deg) translate(-0.08rem, -0.08rem);
    opacity: 0;
  }
  .gallery-taxonomy-options input[type='checkbox']:checked {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .gallery-taxonomy-options input[type='checkbox']:checked::after {
    opacity: 1;
  }
  .gallery-taxonomy-options input[type='checkbox']:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .gallery-featured {
    margin-top: 2.25rem;
  }
  .gallery-featured__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 592px;
    gap: 12px;
  }
  .gallery-featured__card {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 80px;
    gap: 10px;
    border: 2px solid transparent;
    background: color-mix(in srgb, var(--color-bg) 30%, white);
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 1rem;
    line-height: 1.25;
    padding: 3px 8px;
    text-align: left;
  }
  .gallery-featured__card[aria-pressed='true'] {
    border-color: var(--color-accent);
  }
  .gallery-featured__card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .gallery-featured__media {
    width: min(75px, 38%);
    flex: 0 0 min(75px, 38%);
    aspect-ratio: 15 / 14;
    overflow: hidden;
  }
  .gallery-featured__card :global(.gallery-featured__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transform: scale(1.25);
    transform-origin: center 20%;
  }
  .gallery-featured__card span,
  .gallery-featured__card small {
    display: block;
  }
  .gallery-featured__card span {
    min-width: 0;
  }
  .gallery-featured__card strong {
    font-weight: 600;
  }
  .gallery-featured__card small {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  @media (min-width: 700px) {
    .gallery-featured__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 1196px;
    }
  }
  @media (max-width: 999px) {
    .gallery-featured__card {
      font-size: 0.875rem;
    }
    .gallery-featured__card small {
      font-size: 0.75rem;
    }
  }
  .gallery-filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-accent) 30%, transparent);
    margin: 2rem 0 clamp(1.5rem, 4vw, 3rem);
    padding-top: 1.5rem;
  }
  .gallery-filter-summary > div,
  [data-gallery-filter-chips] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .gallery-filter-summary > div[hidden] {
    display: none;
  }
  :global([data-gallery-filter-chips] button) {
    min-height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0.5rem 1rem;
  }
  .link-button {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
  }
  @media (max-width: 699px) {
    .gallery-filters {
      margin-top: 0;
    }
    .gallery-filters > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: max-content;
      min-height: 48px;
      margin-left: auto;
      background: var(--color-accent);
      color: var(--color-bg);
      cursor: pointer;
      padding: 0.75rem 1.25rem;
      font-weight: 700;
    }
    .gallery-filters > summary::-webkit-details-marker {
      display: none;
    }
    .gallery-filters > summary::marker {
      content: '';
    }
    .gallery-filters > summary::after {
      content: '';
      width: 0.55rem;
      height: 0.55rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-0.15rem);
    }
    .gallery-filters[open] > summary {
      width: max-content;
      margin: 0 0 1.25rem auto;
    }
    .gallery-filters[open] > summary::after {
      transform: rotate(225deg) translate(-0.1rem, -0.1rem);
    }
    .gallery-filter-controls {
      display: block;
    }
    .gallery-filter-group {
      display: block;
    }
    .gallery-filter-label {
      display: block;
      margin-bottom: 0.65rem;
    }
    .gallery-filter-taxonomy {
      border-left: 0;
      padding-left: 0;
    }
    .gallery-filter-taxonomy details {
      width: 100%;
      max-width: none;
    }
    .gallery-filter-group + .gallery-filter-group {
      margin-top: 1.25rem;
    }
    .gallery-filter-statuses button {
      flex: 1 1 0;
      padding-inline: 0.45rem;
    }
    .gallery-filter-taxonomy summary {
      min-width: 0;
    }
    .gallery-taxonomy-options {
      position: static;
    }
    .gallery-filter-summary {
      border-top: 0;
      flex-wrap: wrap;
      margin: 1rem 0 1.5rem;
      padding-top: 0;
    }
    .gallery-filter-summary > div {
      align-items: flex-start;
    }
  }
</style>
