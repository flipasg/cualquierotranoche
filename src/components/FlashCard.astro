---
import GalleryImage from './GalleryImage.astro';
import TallyLink from './TallyLink.astro';
import { forms } from '../config/forms';
import { site } from '../data';
interface Props {
  flash: any;
}
const { flash } = Astro.props;
const cardFrame = site.ui.imageSizing.cardFrame ?? {};
const cardStyle = `--card-media-width:${cardFrame.width || '100%'};--card-media-height:${cardFrame.height || 'auto'};`;
---

<article class="card card--media-sized" style={cardStyle} data-reveal>
  <GalleryImage
    src={flash.data.cover}
    alt={flash.data.coverAlt}
    zoomable
    sizes={site.ui.imageSizing.card || site.ui.imageSizing.default}
  /><h3>{flash.data.title}</h3><p class="flash-card-meta">
    <span>{flash.data.code}</span>
    <TallyLink
      url={forms.tattoo}
      params={{ flashCode: flash.data.code, source: 'portfolio-flash' }}
      className="card-cta">{site.ui.flash.requestCta}</TallyLink
    >
  </p>
  {flash.data.description && <p>{flash.data.description}</p>}
</article>

<style>
  .flash-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-block: 0.35rem 0.25rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
</style>
