---
import GalleryImage from './GalleryImage.astro';
import TallyLink from './TallyLink.astro';
import { forms } from '../config/forms';
interface Props {
  flash: any;
}
const { flash } = Astro.props;
---

<article class="card">
  <GalleryImage src={flash.data.cover} alt={flash.data.coverAlt} /><span
    class="status">{flash.data.status}</span
  ><h3>{flash.data.title}</h3><p>
    {flash.data.code} · {flash.data.note}
  </p><TallyLink
    url={forms.tattoo}
    params={{ flashCode: flash.data.code, source: 'portfolio-flash' }}
    linkStyle>Pedir este flash</TallyLink
  >
</article>
