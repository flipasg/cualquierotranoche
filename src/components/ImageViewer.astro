---
import ModalCloseButton from './ModalCloseButton.astro';
import { site } from '../data';
---

<dialog id="image-viewer" class="image-viewer" aria-label="Visor de imágenes">
  <div class="image-viewer__layout">
    <header class="image-viewer__header">
      <output data-viewer-count aria-live="polite" aria-label="Imagen actual"
      ></output>
      <ModalCloseButton viewer label="Cerrar" autofocus />
    </header>
    <div class="image-viewer__stage">
      <div
        class="image-viewer__viewport"
        data-viewer-viewport
        tabindex="0"
        aria-label="Imagen ampliada"
        aria-describedby="image-viewer-help"
      >
        <img data-viewer-image alt="" draggable="false" hidden />
        <p data-viewer-message role="status">Cargando imagen…</p>
      </div>
    </div>
    <footer class="image-viewer__footer" data-viewer-secondary>
      <nav
        class="image-viewer__navigation"
        data-viewer-navigation
        aria-label="Navegación de imágenes"
        hidden
      >
        <button
          type="button"
          data-viewer-previous
          aria-label={site.ui.carousel.previous ?? 'Anterior'}
          title={site.ui.carousel.previous ?? 'Anterior'}
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m14 5-7 7 7 7"></path></svg
          >
        </button>
        <button
          type="button"
          data-viewer-next
          aria-label={site.ui.carousel.next ?? 'Siguiente'}
          title={site.ui.carousel.next ?? 'Siguiente'}
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m10 5 7 7-7 7"></path></svg
          >
        </button>
      </nav>
      <div
        class="image-viewer__zoom"
        role="group"
        aria-label="Zoom de la imagen"
      >
        <button
          type="button"
          data-viewer-out
          aria-label="Reducir imagen"
          title="Reducir imagen (−)"
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="10.5" cy="10.5" r="6.5"></circle><path
              d="m16 16 5 5M7.5 10.5h6"></path></svg
          >
        </button>
        <output data-viewer-zoom aria-live="polite" aria-label="Nivel de zoom"
          >100 %</output
        >
        <button
          type="button"
          data-viewer-in
          aria-label="Ampliar imagen"
          title="Ampliar imagen (+)"
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="10.5" cy="10.5" r="6.5"></circle><path
              d="m16 16 5 5M7.5 10.5h6m-3-3v6"></path></svg
          >
        </button>
        <button
          type="button"
          data-viewer-reset
          aria-label="Ajustar imagen"
          title="Ajustar imagen (0)"
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"></path></svg
          >
        </button>
      </div>
      <div class="image-viewer__caption">
        <p id="image-viewer-caption" data-viewer-caption></p>
        <button
          class="image-viewer__caption-toggle"
          type="button"
          data-viewer-caption-toggle
          aria-expanded="false"
          aria-controls="image-viewer-caption"
          hidden>Ver más</button
        >
        <details data-viewer-description-wrap hidden>
          <summary>Descripción</summary>
          <p data-viewer-description></p>
        </details>
      </div>
    </footer>
    <p id="image-viewer-help" class="image-viewer__help">
      Amplía con +, −, la rueda o dos dedos. Doble toque para ampliar o ajustar.
      Arrastra para explorar. Toca la imagen para mostrar u ocultar los
      controles. Con teclado: 0 para ajustar y Esc para cerrar.
    </p>
  </div>
</dialog>

<style>
  .image-viewer {
    --viewer-bg: color-mix(in srgb, var(--color-text) 38%, black);
    --viewer-ink: var(--color-bg);
    --viewer-control: color-mix(in srgb, var(--color-text) 55%, black);
    --color-action: var(--viewer-ink);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: var(--viewer-bg);
    color: var(--viewer-ink);
    overscroll-behavior: contain;
  }
  .image-viewer::backdrop {
    background: var(--viewer-bg);
  }
  .image-viewer[open] {
    animation: viewer-open 160ms ease-out;
  }
  .image-viewer[data-closing='true'] {
    animation: viewer-close 160ms ease-in forwards;
  }
  @keyframes viewer-open {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes viewer-close {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  .image-viewer__layout {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-columns: minmax(0, 1fr);
    height: 100%;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
      env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
  }
  .image-viewer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    min-height: 60px;
  }
  .image-viewer__header output {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .image-viewer__header :global(.modal-close-button) {
    margin-left: auto;
    border-color: transparent;
    color: var(--viewer-ink);
    background: var(--viewer-bg);
  }
  .image-viewer__stage {
    min-width: 0;
    min-height: 0;
    padding-inline: 4.5rem;
  }
  .image-viewer__viewport {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: zoom-in;
  }
  .image-viewer__viewport[data-zoomed='true'] {
    cursor: grab;
  }
  .image-viewer__viewport[data-dragging='true'][data-zoomed='true'] {
    cursor: grabbing;
  }
  .image-viewer__viewport img {
    grid-area: 1 / 1;
    min-width: 0;
    max-width: none;
    object-fit: contain;
    /* Transparent Flash artwork needs paper behind its original ink colors. */
    background: var(--color-surface);
    pointer-events: none;
  }
  .image-viewer__viewport[data-animate='true'] img {
    transition: transform 160ms ease-out;
  }
  .image-viewer [hidden] {
    display: none;
  }
  .image-viewer__viewport p {
    margin: 1rem;
    text-align: center;
  }
  .image-viewer__footer {
    background: transparent;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 2rem;
    padding: 0.75rem 1.5rem;
  }
  .image-viewer__zoom {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .image-viewer__zoom output {
    min-width: 5ch;
    text-align: center;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .image-viewer__zoom button,
  .image-viewer__navigation button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--viewer-ink) 35%, transparent);
    border-radius: 50%;
    color: var(--viewer-ink);
    background: var(--viewer-control);
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color var(--motion-fast) ease;
  }
  .image-viewer__navigation {
    grid-column: 1;
    grid-row: 1;
  }
  .image-viewer__navigation button {
    position: absolute;
    top: calc(50% - 22px);
    background: var(--color-accent);
    border-color: transparent;
  }
  [data-viewer-previous] {
    left: max(1rem, env(safe-area-inset-left));
  }
  [data-viewer-next] {
    right: max(1rem, env(safe-area-inset-right));
  }
  .image-viewer button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .image-viewer svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .image-viewer :focus-visible {
    outline: 2px solid var(--viewer-ink);
    outline-offset: 3px;
  }
  .image-viewer__viewport:focus-visible {
    outline-offset: -3px;
  }
  .image-viewer__caption {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    max-height: 25dvh;
    overflow: auto;
    overscroll-behavior: contain;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .image-viewer__caption p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  [data-viewer-caption] {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  [data-viewer-caption][data-expanded='true'] {
    display: block;
  }
  .image-viewer__caption-toggle,
  .image-viewer__caption summary {
    min-height: 44px;
    padding: 0.5rem 0;
    color: inherit;
    background: none;
    border: 0;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .image-viewer__caption summary {
    width: fit-content;
  }
  .image-viewer__help {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .image-viewer[data-controls-hidden='true'] [data-viewer-secondary],
  .image-viewer[data-controls-hidden='true'] [data-viewer-count] {
    visibility: hidden;
  }
  @media (hover: hover) {
    .image-viewer__zoom button:not(:disabled):hover {
      background: var(--color-accent);
    }
    .image-viewer__navigation button:not(:disabled):hover {
      background: color-mix(in srgb, var(--color-accent) 80%, var(--viewer-bg));
    }
  }
  @media (max-width: 767px), (pointer: coarse) {
    .image-viewer__stage {
      padding-inline: 0;
    }
    .image-viewer__header {
      padding-inline: 0.75rem;
    }
    .image-viewer__footer {
      grid-template-columns: minmax(0, 1fr);
      position: relative;
      padding: 0.5rem 0.75rem;
      gap: 0.5rem;
    }
    .image-viewer__zoom {
      grid-column: 1;
      justify-self: center;
      gap: 0.5rem;
    }
    .image-viewer__zoom output {
      display: none;
    }
    .image-viewer__navigation button {
      top: 0.5rem;
    }
    [data-viewer-previous] {
      left: 0.75rem;
    }
    [data-viewer-next] {
      right: 0.75rem;
    }
    .image-viewer__caption {
      grid-row: 2;
      text-align: center;
      font-size: 0.8rem;
    }
    .image-viewer__caption summary {
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .image-viewer[open],
    .image-viewer[data-closing='true'] {
      animation: none;
    }
    .image-viewer__viewport img {
      transition: none;
    }
  }
</style>

<script is:inline type="module" src="/scripts/image-viewer.js"></script>
