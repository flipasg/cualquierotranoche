---
import { renderRichText } from '../lib/rich-text.mjs';

interface Props {
  content?: string | null;
  class?: string;
  inline?: boolean;
}

const {
  content,
  class: className,
  inline = false,
} = Astro.props;

const html = renderRichText(content, inline);
---

{html && inline ? (
  <span class:list={['rich-text', className]} set:html={html} />
) : html ? (
  <div class:list={['rich-text', className]} set:html={html} />
) : null}