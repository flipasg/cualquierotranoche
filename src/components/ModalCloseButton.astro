---
interface Props {
  label?: string;
  viewer?: boolean;
  gallery?: boolean;
  autofocus?: boolean;
  className?: string;
}

const {
  label = 'Cerrar',
  viewer = false,
  gallery = false,
  autofocus = false,
  className = '',
} = Astro.props;
---

<button
  type="button"
  class:list={['modal-close-button', className]}
  data-viewer-close={viewer ? '' : undefined}
  data-gallery-close={gallery ? '' : undefined}
  autofocus={autofocus || undefined}
>
  <span>{label}</span>
  <svg aria-hidden="true" viewBox="0 0 20 20" focusable="false">
    <path d="m5 5 10 10M15 5 5 15"></path>
  </svg>
</button>

<style>
  .modal-close-button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-action);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-action);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.2;
    cursor: pointer;
    transition: background-color var(--motion-fast) ease;
  }
  .modal-close-button:hover {
    background: color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .modal-close-button:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }
  .modal-close-button svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
</style>
