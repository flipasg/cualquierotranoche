---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  variant?: 'default' | 'eyebrow';
}

const { items, variant = 'default' } = Astro.props;
---

{
  items.length > 0 && (
    <nav
      class={`breadcrumbs${variant === 'eyebrow' ? ' breadcrumbs--eyebrow' : ''}`}
      aria-label="Migas de pan"
    >
      <ol class="breadcrumbs__list">
        {items.map((item, index) => (
          <li>
            <a
              href={item.href}
              aria-current={
                variant === 'default' && index === items.length - 1
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
