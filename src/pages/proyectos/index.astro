---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import site from '../../data/site.json';
const projects = await getCollection('proyectos', ({ data }) => !data.draft);
---

<BaseLayout
  title={site.ui.illustration.title}
  description={site.ui.illustration.description}
>
  {
    site.ui.illustration.heroImage && (
      <section class="page-header" aria-label={site.ui.illustration.heading}>
        <GalleryImage
          src={site.ui.illustration.heroImage}
          alt={
            site.ui.illustration.heroImageAlt || site.ui.illustration.heading
          }
          loading="eager"
          class="page-header__image"
        />
      </section>
    )
  }
  <section class="container section section-intro section-intro--stacked">
    <div>
      <h1>{site.ui.illustration.heading}</h1><p class="lead">
        {site.ui.illustration.intro}
      </p>
    </div>
  </section><section class="container section">
    <div class="grid grid-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
