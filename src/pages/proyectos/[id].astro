---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import TallyLink from '../../components/TallyLink.astro';
import { forms } from '../../config/forms';
import { site } from '../../data';
import RichText from '../../components/RichText.astro';
export async function getStaticPaths() {
  const projects = await getCollection('proyectos', ({ data }) => !data.draft);
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
        previousProject:
          projects.length > 1
            ? projects[(index - 1 + projects.length) % projects.length]
            : undefined,
      nextProject:
        projects.length > 1
          ? projects[(index + 1) % projects.length]
          : undefined,
    },
  }));
}
const { project, previousProject, nextProject } = Astro.props;
const gallery = project.data.gallery ?? [];
const cardFrame = site.ui.imageSizing.cardFrame ?? {};
const cardStyle = `--card-media-width:${cardFrame.width || '100%'};--card-media-height:${cardFrame.height || 'auto'};`;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  socialImage={project.data.cover}
  socialImageAlt={project.data.coverAlt}
  ><article class="container section detail-page">
    <div class="grid grid-2 proyecto-detail">
      <div data-reveal>
        <div class="detail-navigation">
          <Breadcrumbs
            variant="eyebrow"
            items={[
              {
                label: site.ui.illustration.title ?? 'Proyectos',
                href: '/proyectos/',
              },
              { label: project.data.title, href: `/proyectos/${project.id}/` },
            ]}
          />
          <nav aria-label="Navegación de proyectos">
            {
              previousProject && (
                <a
                  href={`/proyectos/${previousProject.id}/`}
                  aria-label="Anterior"
                >
                  <span class="detail-navigation__icon detail-navigation__icon--previous">
                    <ArrowIcon direction="up" />
                  </span>
                </a>
              )
            }
            {
              nextProject && (
                <a
                  href={`/proyectos/${nextProject.id}/`}
                  aria-label="Siguiente"
                >
                  <span class="detail-navigation__icon detail-navigation__icon--next">
                    <ArrowIcon direction="up" />
                  </span>
                </a>
              )
            }
          </nav>
        </div>
        <h1><RichText content={project.data.title} inline /></h1><p
          class="project-meta"
        >
          {project.data.client} · {project.data.services} · {project.data.year}
        </p><RichText content={project.data.description} class="lead" />
      </div>
      <GalleryImage
        src={project.data.cover}
        alt={project.data.coverAlt}
        loading="eager"
        zoomable
        viewerTitle={project.data.title}
        viewerDescription={project.data.description}
        viewerGroup={`project-${project.id}`}
      />
    </div><section class="container section proyecto-narrative" data-reveal>
      <Eyebrow text={site.ui.illustration.contributionEyebrow} /><h2>
        <RichText content={project.data.contribution} inline />
      </h2><RichText content={project.body} class="prose" />
    </section><section class="proyecto-gallery" data-reveal-group>
      {
        gallery.map((image: any) => (
          <div class="card--media-sized" style={cardStyle} data-reveal>
            <GalleryImage
              src={image.src}
              alt={image.alt}
              sizes={site.ui.imageSizing.card || site.ui.imageSizing.default}
              zoomable
              viewerTitle={project.data.title}
              viewerDescription={project.data.description}
              viewerGroup={`project-${project.id}`}
            />
          </div>
        ))
      }
    </section><section class="proyecto-contact" data-reveal>
      <h2>{site.ui.illustration.contactHeading}</h2>
      {
        site.ui.illustration.projectContactDescription && (
          <p>{site.ui.illustration.projectContactDescription}</p>
        )
      }
      <TallyLink
        url={forms.illustration}
        params={{ source: 'portfolio-proyecto' }}
      >
        {site.ui.illustration.contactCta}
      </TallyLink>
    </section>
  </article></BaseLayout
>

<style>
  .proyecto-detail {
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
  }
  .detail-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0;
  }
  .detail-navigation :global(.breadcrumbs__list) {
    margin-bottom: 0;
  }
  .detail-navigation nav {
    display: flex;
    gap: 0.75rem;
    font-size: 0.875rem;
  }
  .detail-navigation__icon {
    display: inline-flex;
  }
  .detail-navigation__icon--previous {
    transform: rotate(-90deg);
  }
  .detail-navigation__icon--next {
    transform: rotate(90deg);
  }
  .detail-navigation > nav[aria-label='Navegación de proyectos'] {
    flex: 0 0 auto;
    gap: 0.25rem;
  }
  .detail-navigation > nav[aria-label='Navegación de proyectos'] a {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .proyecto-detail .detail-navigation {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }
    .proyecto-detail .detail-navigation :global(.breadcrumbs) {
      flex: 1 1 auto;
      min-width: 0;
    }
    .proyecto-detail .detail-navigation :global(.breadcrumbs__list) {
      flex-wrap: nowrap;
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
    }
    .proyecto-detail
      .detail-navigation
      :global(.breadcrumbs__list li + li::before) {
      margin-inline: 0.35rem;
    }
    .proyecto-detail > [data-reveal] > .detail-navigation > nav {
      flex: 0 0 auto;
      gap: 0;
    }
  }
  @media (max-width: 767px) {
    .detail-navigation {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }
  }
  @media (max-width: 359px) {
    .detail-navigation {
      flex-wrap: nowrap;
      gap: 0.4rem;
    }
    .detail-navigation :global(.breadcrumbs) {
      flex: 1 1 auto;
      min-width: 0;
    }
    .detail-navigation :global(.breadcrumbs__list) {
      flex-wrap: nowrap;
      min-width: 0;
      gap: 0;
      font-size: 0.625rem;
      letter-spacing: 0.06em;
    }
    .detail-navigation > nav[aria-label='Navegación de proyectos'] {
      flex: 0 0 auto;
      gap: 0.25rem;
    }
  }
  .proyecto-detail h1 {
    margin-block: 0.75rem 0.5rem;
    font-size: clamp(1.75rem, 4.5vw, 4rem);
  }
  .project-meta {
    margin: 0.5rem 0;
    color: var(--color-accent);
  }
  .proyecto-detail :global(img) {
    max-height: 76svh;
    object-fit: contain;
  }
  .proyecto-narrative {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: 0;
  }
  .proyecto-contact {
    margin: clamp(3rem, 8vw, 6rem) auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    max-width: 52rem;
  }
  .proyecto-contact p {
    max-width: 38rem;
  }
  .proyecto-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 767px) {
    .proyecto-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .proyecto-gallery .card--media-sized :global(img) {
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }
  @media (min-width: 768px) {
    .proyecto-detail :global(img) {
      max-height: min(62svh, 30rem);
    }
    .proyecto-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .proyecto-gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
