---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import site from '../../data/site.json';
export async function getStaticPaths() {
  return (await getCollection('proyectos', ({ data }) => !data.draft)).map(
    (project) => ({ params: { id: project.id }, props: { project } }),
  );
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  socialImage={project.data.cover}
  socialImageAlt={project.data.coverAlt}
  ><article class="container section">
    <Eyebrow
      text={site.ui.illustration.projectEyebrow}
      prefix={site.ui.illustration.title}
    /><h1>
      {project.data.title}
    </h1><p>
      {project.data.client} · {project.data.services} · {project.data.year}
    </p><p class="lead">{project.data.description}</p><GalleryImage
      src={project.data.cover}
      alt={project.data.coverAlt}
      loading="eager"
      zoomable
    /><section class="section prose">
      <Eyebrow text={site.ui.illustration.contributionEyebrow} /><h2>
        {project.data.contribution}
      </h2><Content />
    </section>{
      project.data.gallery.map((image: any) => (
        <GalleryImage src={image.src} alt={image.alt} zoomable />
      ))
    }
  </article></BaseLayout
>
