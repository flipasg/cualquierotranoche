---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { site } from '../../data';
export async function getStaticPaths() {
  return (await getCollection('proyectos', ({ data }) => !data.draft)).map(
    (project) => ({ params: { id: project.id }, props: { project } }),
  );
}
const { project } = Astro.props;
const { Content } = await render(project);
const gallery = project.data.gallery ?? [];
const cardFrame = site.ui.imageSizing.cardFrame ?? {};
const cardStyle = `--card-media-width:${cardFrame.width || '100%'};--card-media-height:${cardFrame.height || 'auto'};`;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  socialImage={project.data.cover}
  socialImageAlt={project.data.coverAlt}
  ><article class="container section">
    <div class="grid grid-2 proyecto-detail">
      <div>
        <Breadcrumbs
          items={[
            {
              label: site.ui.illustration.title ?? 'Proyectos',
              href: '/proyectos/',
            },
            {
              label: project.data.title,
              href: `/proyectos/${project.id}/`,
            },
          ]}
        /><h1>
          {project.data.title}
        </h1>
        <p>
          {project.data.client} · {project.data.services} · {project.data.year}
        </p><p class="lead">{project.data.description}</p>
      </div>
      <GalleryImage
        src={project.data.cover}
        alt={project.data.coverAlt}
        loading="eager"
        zoomable
      />
    </div><section class="container section">
      <Eyebrow text={site.ui.illustration.contributionEyebrow} /><h2>
        {project.data.contribution}
      </h2><Content />
    </section><section class="proyecto-gallery">
      {
        gallery.map((image: any) => (
          <div class="card--media-sized" style={cardStyle}>
            <GalleryImage
              src={image.src}
              alt={image.alt}
              sizes={site.ui.imageSizing.card || site.ui.imageSizing.default}
              zoomable
            />
          </div>
        ))
      }
    </section>
  </article></BaseLayout
>

<style>
  .proyecto-detail {
    gap: clamp(1.25rem, 4vw, 3rem);
  }
  .proyecto-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 700px) {
    .proyecto-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .proyecto-gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
