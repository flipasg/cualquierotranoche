---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCarousel from '../../components/ContentCarousel.astro';
import FlashCard from '../../components/FlashCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import TattooCard from '../../components/TattooCard.astro';
import { site } from '../../data';
import RichText from '../../components/RichText.astro';
import TallyLink from '../../components/TallyLink.astro';
import { forms } from '../../config/forms';

const flash = await getCollection(
  'flash',
  ({ data }) => !data.draft && data.showInCarousel,
);
const tattoos = await getCollection(
  'tattoos',
  ({ data }) => !data.draft && data.showInCarousel,
);
---

<BaseLayout
  title={site.ui.tattoo.title}
  description={site.ui.tattoo.description}
>
  <section class="container section page-opening tattoo-opening">
    <div class="page-opening__copy" data-reveal>
      <Eyebrow text={site.ui.tattoo.eyebrow ?? 'TATUAJE DE AUTORA'} />
      <h1>{site.ui.tattoo.heading}</h1>
      <RichText content={site.ui.tattoo.intro} class="lead" />
      <div class="button-row">
        <a class="button" href="#flash"
          >{site.ui.tattoo.flashCta ?? 'Ver flash disponibles'}</a
        >
        <TallyLink
          url={forms.tattoo}
          params={{ source: 'portfolio-tattoo' }}
          className="text-link"
          linkStyle
        >
          {site.ui.tattoo.ideaCta ?? 'Tengo una idea'}
        </TallyLink>
      </div>
    </div>
    {
      site.ui.tattoo.heroImage && (
        <GalleryImage
          src={site.ui.tattoo.heroImage}
          alt={site.ui.tattoo.heroImageAlt || site.ui.tattoo.heading || ''}
          loading="eager"
          class="page-opening__image"
        />
      )
    }
  </section>

  <section id="tattoo-content" class="container section">
    <div id="tatuajes" class="container">
      {
        tattoos.length ? (
          <ContentCarousel
            id="tattoo-carousel"
            label={`${site.ui.tattoo.tattoos}`}
            viewAllHref="/tattoo/tatuajes/"
            viewAllLabel={`${site.ui.tattoo.tattoosViewAll}`}
          >
            {tattoos.map((item) => (
              <div class="carousel-item">
                <TattooCard tattoo={item} />
              </div>
            ))}
          </ContentCarousel>
        ) : (
          <>
            <>
              <h2>{site.ui.tattoo.tattoos}</h2>
              <p>{site.ui.tattoo.noTattoos}</p>
            </>
          </>
        )
      }
    </div><div id="flash" class="container">
      <Eyebrow text={site.ui.tattoo.flashSampleNotice} />{
        flash.length ? (
          <ContentCarousel
            id="flash-carousel"
            label={`${site.ui.tattoo.flash}`}
            viewAllHref="/tattoo/flash/"
            viewAllLabel={`${site.ui.tattoo.flashViewAll}`}
            stretchCards={false}
          >
            {flash.map((item) => (
              <div class="carousel-item">
                <FlashCard flash={item} />
              </div>
            ))}
          </ContentCarousel>
        ) : (
          <>
            <>
              <h2>{site.ui.tattoo.flash}</h2>
              <p>{site.ui.tattoo.noFlash}</p>
            </>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  #tatuajes {
    padding-bottom: 1rem;
  }
  #flash {
    margin-top: 2rem;
  }
  @media (max-width: 767px) {
    .tattoo-opening :global(.page-opening__image) {
      display: none;
    }
    #tattoo-content :global(.carousel-controls) {
      display: none;
    }
  }
</style>
