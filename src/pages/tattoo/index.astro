---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCarousel from '../../components/ContentCarousel.astro';
import FlashCard from '../../components/FlashCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import TattooCard from '../../components/TattooCard.astro';
import { site } from '../../data';
const flash = await getCollection(
  'flash',
  ({ data }) => !data.draft && data.showInCarousel,
);
const tattoos = await getCollection(
  'tattoos',
  ({ data }) => !data.draft && data.showInCarousel,
);
---

<BaseLayout
  title={site.ui.tattoo.title}
  description={site.ui.tattoo.description}
>
  {
    site.ui.tattoo.heroImage && (
      <section class='page-header' aria-label={site.ui.tattoo.heading}>
        <GalleryImage
          src={site.ui.tattoo.heroImage}
          alt={site.ui.tattoo.heroImageAlt || site.ui.tattoo.heading}
          loading='eager'
          class='page-header__image'
        />
      </section>
    )
  }
  <section class='container section section-intro section-intro--stacked'>
    <div>
      <h1>{site.ui.tattoo.heading}</h1><p class='lead'>
        {site.ui.tattoo.intro}
      </p><div class='button-row'>
        <a class='button secondary' href='#tattoo-content'
          >{site.ui.tattoo.tattoos}</a
        ><a class='button secondary' href='#flash'>{site.ui.tattoo.flash}</a>
      </div>
    </div>
  </section>

  <section id='tattoo-content' class='container section'>
    <div id='tatuajes' class='container'>
      {
        tattoos.length ? (
          <ContentCarousel
            id='tattoo-carousel'
            label={site.ui.tattoo.tattoos}
            viewAllHref='/tattoo/tatuajes/'
            viewAllLabel={site.ui.tattoo.viewAll}
          >
            {tattoos.map((item) => (
              <div class='carousel-item'>
                <TattooCard tattoo={item} />
              </div>
            ))}
          </ContentCarousel>
        ) : (
          <>
            <>
              <h2>{site.ui.tattoo.tattoos}</h2>
              <p>{site.ui.tattoo.noTattoos}</p>
            </>
          </>
        )
      }
    </div><div id='flash' class='container'>
      <Eyebrow text={site.ui.tattoo.flashSampleNotice} />{
        flash.length ? (
          <ContentCarousel
            id='flash-carousel'
            label={site.ui.tattoo.flash}
            viewAllHref='/tattoo/flash/'
            viewAllLabel={site.ui.tattoo.viewAll}
          >
            {flash.map((item) => (
              <div class='carousel-item'>
                <FlashCard flash={item} />
              </div>
            ))}
          </ContentCarousel>
        ) : (
          <>
            <>
              <h2>{site.ui.tattoo.flash}</h2>
              <p>{site.ui.tattoo.noFlash}</p>
            </>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  #tatuajes {
    padding-bottom: 2rem;
  }
</style>
