---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCarousel from '../../components/ContentCarousel.astro';
import FlashCard from '../../components/FlashCard.astro';
import TattooCard from '../../components/TattooCard.astro';
const flash = await getCollection(
  'flash',
  ({ data }) => !data.draft && data.showInCarousel,
);
const tattoos = await getCollection(
  'tattoos',
  ({ data }) => !data.draft && data.showInCarousel,
);
---

<BaseLayout title="Tattoo" description="Tatuajes y diseños flash."
  ><section class="container section">
    <h1>Tattoo</h1><p class="lead">
      Una selección de tatuajes y diseños que están buscando su lugar.
    </p><div class="button-row">
      <a class="button secondary" href="#tatuajes">Tatuajes</a><a
        class="button secondary"
        href="#flash">Flash</a
      >
    </div>
  </section><section id="tatuajes" class="container section">
    <div class="section-heading">
      <h2>Tatuajes</h2><a href="/tattoo/tatuajes/">Ver todos</a>
    </div>{
      tattoos.length ? (
        <ContentCarousel id="tattoo-carousel" label="Tatuajes">
          {tattoos.map((item) => (
            <div class="carousel-item">
              <TattooCard tattoo={item} />
            </div>
          ))}
        </ContentCarousel>
      ) : (
        <p>No hay tatuajes seleccionados para mostrar.</p>
      )
    }
  </section><section id="flash" class="container section">
    <p class="eyebrow">Diseños de muestra · no son obras reales</p><div
      class="section-heading"
    >
      <h2>Flash</h2><a href="/tattoo/flash/">Ver todos</a>
    </div>{
      flash.length ? (
        <ContentCarousel id="flash-carousel" label="Flash">
          {flash.map((item) => (
            <div class="carousel-item">
              <FlashCard flash={item} />
            </div>
          ))}
        </ContentCarousel>
      ) : (
        <p>No hay flash seleccionados para mostrar.</p>
      )
    }
  </section></BaseLayout
>

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-heading h2 {
    margin-bottom: 1rem;
  }
</style>
