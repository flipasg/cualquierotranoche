---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FlashCard from '../../components/FlashCard.astro';
import GalleryFilters from '../../components/GalleryFilters.astro';
import { flashCategories } from '../../data';
import { site } from '../../data';

const flash = await getCollection('flash', ({ data }) => !data.draft);
const categories = [...(flashCategories.categories ?? [])]
  .sort((first, second) => first.order - second.order)
  .map((category) => {
    const categoryFlash = flash.filter((item) =>
      item.data.categories.includes(category.id),
    );
    const source = categoryFlash.find(
      (item) =>
        item.data.code === category.imageFrom || item.id === category.imageFrom,
    );
    return {
      id: category.id,
      label: category.label,
      count: categoryFlash.length,
      featured: category.featured,
      image: category.image ?? source?.data.cover,
      imageAlt: category.imageAlt ?? source?.data.coverAlt,
    };
  });
const flashStatuses = [
  {
    id: 'disponible',
    label: site.ui.flash.available ?? 'Disponibles',
    count: flash.filter((item) => item.data.status === 'disponible').length,
  },
  { id: 'all', label: site.ui.flash.all ?? 'Todos', count: flash.length },
  {
    id: 'vendido',
    label: site.ui.flash.sold ?? 'Vendidos',
    count: flash.filter((item) => item.data.status === 'vendido').length,
  },
];
---

<BaseLayout
  title={site.ui.flash.title}
  description={site.ui.flash.description}
  showBackToTop
  ><div data-gallery data-gallery-taxonomy-param="category">
    <section class="container section flash-page">
      <Breadcrumbs
        items={[
          { label: site.ui.tattoo.title ?? 'Tattoo', href: '/tattoo/' },
          { label: site.ui.flash.title ?? 'Flashbook', href: '/tattoo/flash/' },
        ]}
      />
      <div class="flash-opening-copy" data-reveal>
        <h1>{site.ui.flash.heading}</h1>
        <p class="lead">{site.ui.flash.description}</p>
      </div>
      <GalleryFilters
        taxonomyLabel={site.ui.flash.taxonomyLabel ?? ''}
        taxonomyAllLabel="Todas las categorías"
        featuredLabel="Categorías destacadas"
        statusLabel={site.ui.flash.statusLabel ?? ''}
        activeLabel={site.ui.flash.activeFiltersLabel ?? ''}
        clearLabel={site.ui.flash.clearFiltersLabel ?? 'Limpiar'}
        filterLabel={site.ui.flash.filterLabel ?? 'Filtros'}
        applyLabel={site.ui.flash.applyLabel ?? 'Ver resultados'}
        showStatusCounts={site.ui.flash.showStatusCounts ?? false}
        showCategoryCounts={site.ui.flash.showCategoryCounts ?? false}
        showResultCount={false}
        showActiveFilters={site.ui.flash.showActiveFilters ?? true}
        showClearButton={site.ui.flash.showClearButton ?? true}
        showTaxonomySearch={site.ui.flash.showTaxonomySearch ?? true}
        taxonomySearchLabel={site.ui.flash.taxonomySearchLabel ??
          'Buscar categorías'}
        showGlobalSearch={site.ui.flash.showGlobalSearch ?? true}
        globalSearchLabel={site.ui.flash.globalSearchLabel ?? ''}
        globalSearchPlaceholder={site.ui.flash.globalSearchPlaceholder ??
          'Buscar por título'}
        searchParam={site.ui.flash.searchParam ?? 'search'}
        itemLabel="flash"
        emptyLabel={site.ui.flash.empty ?? 'No hay flash en esta categoría.'}
        urlParam="category"
        defaultStatus="disponible"
        statuses={flashStatuses}
        taxonomies={categories}
      />
      <div
        class="grid grid-3 gallery-card-grid"
        data-reveal-group
        data-flash-grid
        role="region"
        aria-label={site.ui.flash.heading}
        tabindex="-1"
      >
        {
          flash.map((item) => (
            <div
              data-flash-card
              data-gallery-card
              data-gallery-status={item.data.status}
              data-gallery-taxonomies={item.data.categories.join(' ')}
              data-flash-categories={item.data.categories.join(' ')}
            >
              <FlashCard flash={item} />
            </div>
          ))
        }
      </div>
      <div class="pagination-layout" data-gallery-pagination>
        <nav
          data-flash-pagination
          data-gallery-pagination-controls
          data-page-size="6"
          data-page-size-tablet="6"
          data-page-size-desktop="8"
          aria-label={site.ui.flash.paginationLabel}
          data-previous-label={site.ui.flash.previous}
          data-next-label={site.ui.flash.next}
          data-page-status={site.ui.flash.pageStatus}
        >
        </nav>
      </div>
    </section>
  </div></BaseLayout
>

<style>
  .flash-page {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .flash-page h1 {
    max-width: none;
  }
  .flash-opening-copy {
    max-width: 54rem;
    margin-bottom: 1.5rem;
  }
  .flash-opening-copy .lead {
    font-size: 1rem;
    max-width: 42rem;
  }
  [data-flash-grid]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  :global(.gallery-card-grid[data-flash-grid]) {
    grid-template-columns: minmax(0, 1fr);
  }
  :global(.gallery-card-grid[data-flash-grid] .card--media-sized img) {
    height: auto;
    object-fit: contain;
  }
  @media (min-width: 768px) {
    :global(.gallery-card-grid[data-flash-grid]) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    :global(.gallery-card-grid[data-flash-grid]) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .pagination-layout,
  [data-flash-pagination] {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .pagination-layout {
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .pagination-layout[hidden],
  [data-flash-pagination][hidden] {
    display: none;
  }
  :global([data-flash-pagination] button) {
    min-height: 2rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  :global([data-flash-pagination] button:disabled) {
    cursor: default;
    opacity: 0.5;
  }
</style>

<script is:inline src="/scripts/gallery-filters.js"></script>
