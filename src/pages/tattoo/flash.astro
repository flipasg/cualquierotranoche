---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlashCard from '../../components/FlashCard.astro';
import flashCategories from '../../data/flash-categories.json';
import site from '../../data/site.json';

const flash = await getCollection('flash', ({ data }) => !data.draft);
const categories = flashCategories.categories;
const defaultCategory =
  categories.find((category) => category.id === 'destacados')?.id ??
  categories[0]?.id ??
  'all';
---

<BaseLayout title={site.ui.flash.title} description={site.ui.flash.description}
  ><section class="container section">
    <h1>{site.ui.flash.heading}</h1><div
      class="filters"
      aria-label={site.ui.flash.filtersLabel}
      role="group"
    >
      {
        categories.map((category) => (
          <button
            type="button"
            data-flash-category={category.id}
            aria-pressed={category.id === defaultCategory ? 'true' : 'false'}
          >
            {category.label}
          </button>
        ))
      }<button
        class="all-filter"
        type="button"
        data-flash-category="all"
        aria-pressed={defaultCategory === 'all' ? 'true' : 'false'}
      >
        {site.ui.flash.all}
      </button>
    </div><p data-flash-empty hidden>{site.ui.flash.empty}</p><div
      class="grid grid-3"
      data-flash-grid
    >
      {
        flash.map((item) => (
          <div
            data-flash-card
            data-flash-categories={item.data.categories.join(' ')}
          >
            <FlashCard flash={item} />
          </div>
        ))
      }
    </div><div class="pagination-layout">
      <label class="page-size" for="flash-page-size"
        >{site.ui.flash.pageSizeBefore}<select
          id="flash-page-size"
          data-flash-page-size
        >
          <option value="6">6</option>
          <option value="12">12</option>
          <option value="18">18</option>
          <option value="24">24</option>
        </select>{site.ui.flash.pageSizeAfter}</label
      ><nav
        data-flash-pagination
        aria-label={site.ui.flash.paginationLabel}
        data-previous-label={site.ui.flash.previous}
        data-next-label={site.ui.flash.next}
        data-page-status={site.ui.flash.pageStatus}
      >
      </nav>
    </div>
  </section></BaseLayout
>

<style>
  .all-filter {
    opacity: 0.65;
  }
  .all-filter[aria-pressed='true'] {
    opacity: 1;
  }
  .pagination-layout,
  [data-flash-pagination] {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .pagination-layout {
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .page-size {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  [data-flash-pagination] button,
  [data-flash-page-size] {
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  :global([data-flash-pagination] button:disabled) {
    cursor: default;
    opacity: 0.5;
  }
</style>

<script is:inline src="/scripts/flash-gallery.js"></script>
