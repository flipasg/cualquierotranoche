---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TattooCard from '../../components/TattooCard.astro';
import { site } from '../../data';

const tattoos = await getCollection('tattoos', ({ data }) => !data.draft);
---

<BaseLayout
  title={site.ui.tattoo.tattoos}
  description={site.ui.tattoo.description}
  ><section class="container section">
    <h1>{site.ui.tattoo.tattoos}</h1><div class="grid grid-3">
      {tattoos.map((item) => <TattooCard tattoo={item} />)}
    </div>
  </section></BaseLayout
>
