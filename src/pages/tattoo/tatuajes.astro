---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TattooCard from '../../components/TattooCard.astro';

const tattoos = await getCollection('tattoos', ({ data }) => !data.draft);
---

<BaseLayout title="Tatuajes" description="Galería de tatuajes."
  ><section class="container section">
    <p class="eyebrow">TATTOO</p><h1>Tatuajes</h1><div class="grid grid-3">
      {tattoos.map((item) => <TattooCard tattoo={item} />)}
    </div>
  </section></BaseLayout
>
