---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactOptions from '../components/ContactOptions.astro';
import site from '../data/site.json';
---

<BaseLayout
  title={site.ui.contact.title}
  description={site.ui.contact.description}
  ><section class="container section">
    <h1>{site.ui.contact.heading}</h1><p class="lead">
      {site.ui.contact.intro}
    </p><ContactOptions />
  </section></BaseLayout
>
