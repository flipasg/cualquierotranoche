---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactOptions from '../components/ContactOptions.astro';
import Eyebrow from '../components/Eyebrow.astro';
import GuestAgenda from '../components/GuestAgenda.astro';
import SiteInfo from '../components/SiteInfo.astro';
import { guests } from '../config/guests';
import site from '../data/site.json';
---

<BaseLayout
  title={site.ui.contact.title}
  description={site.ui.contact.description}
  showFooter={false}
  ><section class="container section contact-layout">
    <div>
      <Eyebrow text={site.ui.contact.eyebrow} />
      <h1>{site.ui.contact.heading}</h1><p class="lead">
        {site.ui.contact.intro}
      </p><ContactOptions />
      <div class="contact-info"><SiteInfo showContactLink={false} /></div>
    </div>
    <div class="contact-agenda"><GuestAgenda config={guests} /></div>
  </section></BaseLayout
>

<style>
  .contact-layout {
    display: grid;
    gap: 3rem;
  }
  .contact-layout > div {
    min-width: 0;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: -0.035em;
    margin-bottom: 2rem;
    max-width: none;
    overflow-wrap: anywhere;
  }
  .lead {
    margin-bottom: 2rem;
  }
  .contact-info {
    margin-top: 3rem;
  }
  .contact-agenda {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  @media (min-width: 800px) {
    .contact-layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .contact-agenda {
      border-top: 0;
      border-left: 1px solid var(--color-border);
      padding-top: 0;
      padding-left: clamp(2rem, 4vw, 3rem);
    }
  }
</style>
