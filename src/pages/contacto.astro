---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactOptions from '../components/ContactOptions.astro';
import GuestAgenda from '../components/GuestAgenda.astro';
import SiteInfo from '../components/SiteInfo.astro';
import { guests } from '../config/guests';
import { site } from '../data';
import { visibleGuests } from '../lib/guests';

const hasVisibleGuests = visibleGuests(guests.entries).length > 0;
---

<BaseLayout
  title={site.ui.contact.title}
  description={site.ui.contact.description}
  showFooter={false}
>
  <section class="container contact-page">
    <div
      class:list={[
        'contact-content',
        { 'contact-content--without-agenda': !hasVisibleGuests },
      ]}
    >
      <div class="contact-copy">
        <header class="contact-intro">
          <h1>{site.ui.contact.heading}</h1>
          <p class="lead">{site.ui.contact.intro}</p>
        </header>
        <ContactOptions />
      </div>
      {
        hasVisibleGuests && (
          <GuestAgenda config={guests} presentation="contact" />
        )
      }
    </div>
    <footer class="contact-footer">
      <SiteInfo showStudioInfo variant="contact" />
    </footer>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .contact-intro h1 {
    margin-bottom: 0.6rem;
    font-size: clamp(2.8rem, 6vw, 5rem);
    letter-spacing: -0.045em;
  }
  .contact-intro .lead {
    margin: 0;
    color: var(--color-muted);
  }
  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .contact-content > * {
    min-width: 0;
  }
  .contact-content--without-agenda {
    max-width: 52rem;
  }
  .contact-footer {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .contact-content {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .contact-content--without-agenda {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
