---
import BaseLayout from '../layouts/BaseLayout.astro';import GalleryImage from '../components/GalleryImage.astro';import DisciplineCard from '../components/DisciplineCard.astro';import site from '../data/site.json';
---
<BaseLayout title="Portfolio artístico" description="Portfolio de muestra de tattoo, obra original e ilustración."><section class="container section hero"><div><p class="eyebrow">TATTOO · OBRA ORIGINAL · ILUSTRACIÓN</p><h1>Dibujar, crear, dejar una huella.</h1><p class="lead">{site.intro}</p><div class="button-row"><a class="button" href="#trabajo">Ver mi trabajo</a><a class="button secondary" href="/sobre-mi/">Un poco sobre mí</a></div></div><GalleryImage src="/uploads/estudio-placeholder.svg" alt="Fotografía en el estudio pendiente" loading="eager"/></section><section id="trabajo" class="container section"><p class="eyebrow">Tres disciplinas</p><h2>Explora mi trabajo</h2><div class="grid grid-3"><DisciplineCard number="01" title="Tattoo" text="Piezas realizadas y diseños disponibles" href="/tattoo/"/><DisciplineCard number="02" title="Obra original" text="Papel, pintura y collage" href="/obra/"/><DisciplineCard number="03" title="Ilustración" text="Imágenes para proyectos y marcas" href="/ilustracion/"/></div></section><section class="container section editorial"><div><p class="eyebrow">01 / DIRECCIÓN</p><h3>Un catálogo con aire</h3><p>Una propuesta cálida y sobria. La personalidad debe venir de sus imágenes, de la escala y de la tipografía.</p></div><div><p class="eyebrow">LA PORTADA</p><h3>Foto y trabajo conviven</h3><p>El retrato presenta a la artista. Las tres disciplinas aparecen pronto y tienen el mismo nivel de acceso.</p></div><div><p class="eyebrow">PALETA PROPUESTA</p><p>Marfil, tinta y granate. El color acompaña a las imágenes.</p></div></section><section class="container section editorial"><div><p class="eyebrow">08 / ADAPTACIÓN</p><h3>Grande, legible y sin gestos ocultos</h3><p>Una columna para mirar las obras. Botones amplios. Formularios en orden vertical. El menú reúne los mismos accesos.</p></div><div><p class="eyebrow">TIPOGRAFÍA</p><p>Serif en títulos y sans serif en navegación, fichas y formularios.</p></div><div><p class="eyebrow">PARA LA SIGUIENTE VERSIÓN</p><p>Sustituir las muestras por su fotografía, sus obras, su nombre y su voz. La estructura ya queda planteada.</p></div></section></BaseLayout>
