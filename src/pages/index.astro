---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryImage from '../components/GalleryImage.astro';
import DisciplineCard from '../components/DisciplineCard.astro';
import { site } from '../data';
---

<BaseLayout
  title={site.ui.homePage.title}
  description={site.ui.homePage.description}
  ><section class="container section hero">
    <div>
      <h1>{site.home.title}</h1><p class="lead">
        {site.home.intro}
      </p><div class="button-row">
        <a class="button" href={site.home.primaryCta?.href}
          >{site.home.primaryCta?.label}</a
        ><a class="button secondary" href={site.home.secondaryCta?.href}
          >{site.home.secondaryCta?.label}</a
        >
      </div>
      {
        site.home.guestsCta?.visible && (
          <a class="home-guests-link" href={site.home.guestsCta?.href}>
            {site.home.guestsCta?.label}
          </a>
        )
      }
    </div><GalleryImage
      src={site.home.heroImage}
      alt={site.home.heroImageAlt}
      loading="eager"
    />
  </section><section id="trabajo" class="container section">
    <h2>{site.home.workHeading}</h2><div class="grid grid-3">
      {
        site.home.disciplines?.map((discipline) => (
          <DisciplineCard {...discipline} />
        ))
      }
    </div>
  </section></BaseLayout
>

<style>
  .home-guests-link {
    display: inline-block;
    margin-top: 1rem;
    padding-block: 0.6rem;
    font-weight: 700;
    text-underline-offset: 0.25em;
  }
</style>
