---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import GalleryImage from '../../../components/GalleryImage.astro';
import ArrowIcon from '../../../components/ArrowIcon.astro';
import TallyLink from '../../../components/TallyLink.astro';
import { forms } from '../../../config/forms';
import { artworkCollections, site } from '../../../data';
import RichText from '../../../components/RichText.astro';

export async function getStaticPaths() {
  const works = await getCollection(
    'obras',
    ({ data }) => !data.draft && Boolean(data.collection),
  );
  return works.map((work) => {
    const collectionWorks = works.filter(
      (item) => item.data.collection === work.data.collection,
    );
    const index = collectionWorks.findIndex((item) => item.id === work.id);
    return {
      params: { collection: work.data.collection!, id: work.id },
      props: {
        work,
        previousWork: collectionWorks[index - 1],
        nextWork: collectionWorks[index + 1],
      },
    };
  });
}

const { work, previousWork, nextWork } = Astro.props;

const collection = artworkCollections.collections?.find(
  (collection) => collection.id === work.data.collection,
);

const gallery = work.data.gallery ?? [];
const media = await import('../../../generated/media.json');
const mediaSources = media.default as Record<string, { src: string }>;
const viewerGroup = `artwork-${work.id}`;
const statusLabel =
  work.data.status === 'disponible'
    ? (site.ui.artwork.statusAvailable ?? 'Disponible')
    : work.data.status === 'reservada'
      ? (site.ui.artwork.statusReserved ?? 'Reservada')
      : work.data.status === 'vendida'
        ? (site.ui.artwork.statusSold ?? 'Vendida')
        : undefined;
      const canShowPurchaseInfo = work.data.status !== 'vendida';
const imageItems = [
  { src: work.data.cover, alt: work.data.coverAlt },
  ...gallery,
];
---

<BaseLayout
  title={work.data.title}
  description={work.data.description}
  socialImage={work.data.cover}
  socialImageAlt={work.data.coverAlt}
>
  <article class="container section detail-page">
    <div class="grid grid-2 obra-detail">
      <div class="obra-detail__image" data-obra-gallery>
        <div class="obra-detail__media">
          <GalleryImage
            src={work.data.cover}
            alt={work.data.coverAlt}
            loading="eager"
            zoomable
            viewerTitle={work.data.title}
            viewerGroup={viewerGroup}
            class="obra-main-image"
          />
          {
            imageItems.slice(1).map((image: any) => (
              <a
                href={mediaSources[image.src]?.src ?? image.src}
                data-image-viewer-trigger
                data-viewer-title={work.data.title}
                data-viewer-group={viewerGroup}
                aria-hidden="true"
                tabindex="-1"
                hidden
              >
                <img alt={image.alt} />
              </a>
            ))
          }
          <div
            class="obra-image-controls"
            aria-label="Navegación de imágenes"
          >
            <button
              type="button"
              class="obra-image-control--previous"
              data-obra-image-previous
              aria-label={site.ui.carousel.previous ?? 'Anterior'}
              title={site.ui.carousel.previous ?? 'Anterior'}
              disabled
            >
              <ArrowIcon />
            </button>
            <span data-obra-image-count>1 / {imageItems.length}</span>
            <button
              type="button"
              data-obra-image-next
              aria-label={site.ui.carousel.next ?? 'Siguiente'}
              title={site.ui.carousel.next ?? 'Siguiente'}
              disabled={imageItems.length < 2}
            >
              <ArrowIcon />
            </button>
          </div>
          <div class="obra-thumbnails" aria-label="Imágenes de la obra">
            {
              imageItems.map((image: any, index: number) => (
                <button
                  type="button"
                  class="obra-thumbnail"
                  data-obra-image-thumbnail
                  aria-label={`Ver imagen ${index + 1}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <GalleryImage
                    src={image.src}
                    alt={image.alt}
                    sizes="96px"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="obra-detail__summary" data-reveal>
        <div class="detail-navigation">
          <Breadcrumbs
            variant="eyebrow"
            items={[
              { label: site.ui.artwork.title ?? 'Obra', href: '/obra/' },
              {
                label: collection?.title ?? work.data.collection,
                href: `/obra/${work.data.collection}/`,
              },
            ]}
          />
          <nav aria-label="Navegación de obras">
            {
              previousWork && (
                <a
                  href={`/obra/${work.data.collection}/${previousWork.id}/`}
                  aria-label="Anterior"
                >
                  <span class="detail-navigation__icon detail-navigation__icon--previous">
                    <ArrowIcon direction="up" />
                  </span>
                </a>
              )
            }
            {
              nextWork && (
                <a
                  href={`/obra/${work.data.collection}/${nextWork.id}/`}
                  aria-label="Siguiente"
                >
                  <span class="detail-navigation__icon detail-navigation__icon--next">
                    <ArrowIcon direction="up" />
                  </span>
                </a>
              )
            }
          </nav>
        </div>
        <h1><RichText content={work.data.title} inline /></h1>
        {
          statusLabel && (
            <p class="obra-status">
              {statusLabel} · {site.ui.artwork.itemTypeLabel ?? 'Obra original'}
            </p>
          )
        }
        <section class="obra-description">
          <RichText content={work.body} />
        </section>
        <dl class="obra-specs">
          {
            work.data.technique && (
              <div>
                <>
                  <dt>{site.ui.artwork.techniqueLabel ?? 'Técnica'}</dt>
                  <dd>{work.data.technique}</dd>
                </>
              </div>
            )
          }
          {
            work.data.dimensions && (
              <div>
                <>
                  <dt>{site.ui.artwork.dimensionsLabel ?? 'Medidas'}</dt>
                  <dd>{work.data.dimensions}</dd>
                </>
              </div>
            )
          }
        </dl>
        {
          work.data.showPrice && work.data.priceEur ? (
            <p class="obra-price">{work.data.priceEur} €</p>
          ) : null
        }
        {
          canShowPurchaseInfo && site.ui.artwork.shipping && (
            <p class="obra-shipping">{site.ui.artwork.shipping}</p>
          )
        }

        {
          work.data.status === 'disponible' && (
            <TallyLink
              className="obra-interest"
              url={forms.artwork}
              params={{ artworkId: work.id, source: 'portfolio-obra' }}
            >
              {site.ui.artwork.interestCta}
            </TallyLink>
          )
        }
        {
          work.data.status === 'vendida' && (
            <>
              <TallyLink
                className="obra-interest"
                url={forms.general}
                params={{ source: 'portfolio-obra-vendida' }}
              >
                {site.ui.artwork.soldInterestCta ??
                  'Consultar por una obra similar'}
              </TallyLink>
              <p class="obra-purchase-note">
                {site.ui.artwork.soldInterestNote ??
                  'Cuéntame qué te ha interesado de esta pieza para orientarte sobre obras similares o posibles encargos personalizados.'}
              </p>
            </>
          )
        }
        {
          canShowPurchaseInfo && (
            <p class="obra-purchase-note">
              {
                site.ui.artwork.purchaseNote ??
                  'Consulta disponibilidad y envío. Enviar el formulario no confirma la compra.'
              }
            </p>
          )
        }
      </div>
    </div>

  </article>
</BaseLayout>

<script>
  document.querySelectorAll('[data-obra-gallery]').forEach((gallery) => {
    const mainLink = gallery.querySelector<HTMLAnchorElement>(
      '[data-image-viewer-trigger]',
    );
    const mainImage = mainLink?.querySelector<HTMLImageElement>('img');
    const media = gallery.querySelector<HTMLElement>('.obra-detail__media');
    const thumbnails = [
      ...gallery.querySelectorAll<HTMLButtonElement>(
        '[data-obra-image-thumbnail]',
      ),
    ];
    const previous = gallery.querySelector<HTMLButtonElement>(
      '[data-obra-image-previous]',
    );
    const next = gallery.querySelector<HTMLButtonElement>(
      '[data-obra-image-next]',
    );
    const count = gallery.querySelector<HTMLElement>('[data-obra-image-count]');
    if (
      !mainLink ||
      !mainImage ||
      !media ||
      !previous ||
      !next ||
      !count ||
      !thumbnails.length
    )
      return;

    const syncMediaWidth = () => {
      const imageWidth = Number(mainImage.getAttribute('width'));
      const imageHeight = Number(mainImage.getAttribute('height'));
      const maxHeight = Number.parseFloat(
        getComputedStyle(mainImage).maxHeight,
      );
      if (!imageWidth || !imageHeight || !maxHeight) return;
      const scale = Math.min(
        1,
        gallery.clientWidth / imageWidth,
        maxHeight / imageHeight,
      );
      media.style.width = `${imageWidth * scale}px`;
    };
    syncMediaWidth();
    new ResizeObserver(syncMediaWidth).observe(mainImage);
    window.addEventListener('resize', syncMediaWidth);

    let activeIndex = 0;

    const activate = (index: number) => {
      const thumbnail = thumbnails[index];
      if (!thumbnail) return;
      activeIndex = index;
      const image = thumbnail.querySelector<HTMLImageElement>('img');
      if (!image) return;
      const source = image.getAttribute('src') || image.src;
      mainLink.href = source;
      mainImage.src = source;
      mainImage.removeAttribute('srcset');
      mainImage.alt = image.alt;
      mainLink.setAttribute('aria-label', `Ampliar imagen: ${image.alt}`);
      thumbnails.forEach((thumbnail, thumbnailIndex) => {
        thumbnail.setAttribute('aria-pressed', String(thumbnailIndex === index));
      });
      previous.disabled = index === 0;
      next.disabled = index === thumbnails.length - 1;
      count.textContent = `${index + 1} / ${thumbnails.length}`;
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => activate(index));
    });
    previous.addEventListener('click', () => activate(activeIndex - 1));
    next.addEventListener('click', () => activate(activeIndex + 1));
  });
</script>

<style>
  .detail-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .detail-navigation :global(.breadcrumbs__list) {
    margin-bottom: 0;
  }
  .detail-navigation nav {
    display: flex;
    gap: 0.75rem;
    font-size: 0.875rem;
  }
  .detail-navigation__icon {
    display: inline-flex;
  }
  .detail-navigation__icon--previous {
    transform: rotate(-90deg);
  }
  .detail-navigation__icon--next {
    transform: rotate(90deg);
  }
  .detail-navigation > nav[aria-label='Navegación de obras'] {
    flex: 0 0 auto;
    gap: 0.25rem;
  }
  .detail-navigation > nav[aria-label='Navegación de obras'] a {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
  }
  @media (max-width: 767px) {
    .detail-navigation {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }
  }
  @media (max-width: 359px) {
    .detail-navigation {
      flex-wrap: nowrap;
      gap: 0.4rem;
    }
    .detail-navigation :global(.breadcrumbs) {
      flex: 1 1 auto;
      min-width: 0;
    }
    .detail-navigation :global(.breadcrumbs__list) {
      flex-wrap: nowrap;
      min-width: 0;
      gap: 0;
      font-size: 0.625rem;
      letter-spacing: 0.06em;
    }
    .detail-navigation > nav[aria-label='Navegación de obras'] {
      flex: 0 0 auto;
      gap: 0.25rem;
    }
  }
  .obra-detail {
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    min-width: 0;
  }
  .obra-detail__image,
  .obra-detail__summary {
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }
  .obra-detail__image {
    display: flex;
    justify-content: center;
  }
  .obra-detail__media {
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }
  .obra-detail__image :global(.gallery-image-link) {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .obra-detail__image :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(52svh, 34rem);
    object-fit: contain;
  }
  .obra-detail__summary {
    max-width: 38rem;
  }
  .obra-detail__summary h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
  }
  .obra-description {
    margin: 0.75rem 0 1.25rem;
  }
  .obra-description :global(p) {
    font-size: 0.95rem;
  }
  .obra-status {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .obra-specs {
    display: grid;
    gap: 0.7rem;
    margin: 1.5rem 0;
  }
  .obra-specs div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.45fr) minmax(0, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.65rem;
  }
  .obra-specs dt {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .obra-specs dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .obra-price {
    margin: 0.75rem 0 0;
    color: var(--color-accent);
    font: 700 clamp(1.8rem, 3vw, 2.5rem)/1.1 var(--font-body);
  }
  .obra-shipping {
    margin: 0.45rem 0 1.25rem;
    color: var(--color-muted);
  }
  .obra-purchase-note {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 0.85rem;
  }
  .obra-image-controls,
  .obra-thumbnails {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
  }
  .obra-image-controls {
    justify-content: space-between;
    gap: 0;
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }
  .obra-image-controls button {
    display: grid;
    flex: 0 0 var(--control-min-height);
    width: var(--control-min-height);
    min-height: var(--control-min-height);
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .obra-image-control--previous :global(svg) {
    transform: rotate(180deg);
  }
  .obra-image-controls button :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .obra-image-controls button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .obra-thumbnails {
    overflow-x: auto;
    margin-top: 0.75rem;
    gap: 0.375rem;
    padding: 0.375rem 0.25rem;
  }
  .obra-thumbnail {
    flex: 0 0 4.75rem;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    cursor: pointer;
  }
  .obra-thumbnail[aria-pressed='true'] {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .obra-thumbnail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 767px) {
    .obra-detail {
      grid-template-columns: minmax(0, 1fr);
    }
    .obra-detail__summary {
      grid-row: 1;
    }
    .obra-detail__image {
      grid-row: 2;
    }
  }
  @media (min-width: 1024px) {
    .obra-detail {
      margin-bottom: 1rem;
    }
  }
</style>
