---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import WorkCard from '../../../components/WorkCard.astro';
import RichText from '../../../components/RichText.astro';
import { artworkCollections, site } from '../../../data';

export async function getStaticPaths() {
  return artworkCollections.collections?.map((collection) => ({
    params: { collection: collection.id },
    props: { collection },
  }));
}

const { collection } = Astro.props;

const works = (await getCollection('obras', ({ data }) => !data.draft)).filter(
  (work) => work.data.collection === collection.id,
);
---

<BaseLayout title={collection.title} description={collection.description ?? ''}>
  <section class="container section collection-gallery-page">
    <div class="collection-gallery-heading" data-reveal>
      <Breadcrumbs
        items={[
          { label: site.ui.artwork.title ?? 'Obra', href: '/obra/' },
          { label: collection.title, href: `/obra/${collection.id}/` },
        ]}
      />
      <h1>{collection.title}</h1>
      <RichText content={collection.description} class="lead" />
    </div>
    <div class="grid grid-3 gallery-card-grid" data-reveal-group>
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .collection-gallery-page {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .collection-gallery-heading {
    max-width: 54rem;
    margin-bottom: 1.75rem;
  }
  .collection-gallery-heading h1 {
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .collection-gallery-heading .lead {
    font-size: 1rem;
  }
  @media (max-width: 767px) {
    :global(.collection-gallery-page .gallery-card-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    :global(.collection-gallery-page .gallery-card-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    :global(.collection-gallery-page .gallery-card-grid) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
