---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import site from '../../data/site.json';
const works = await getCollection('obras', ({ data }) => !data.draft);
const collections = [
  ...new Set(works.map((work) => work.data.collection)),
].sort((first, second) => first.localeCompare(second));
---

<BaseLayout
  title={site.ui.artwork.title}
  description={site.ui.artwork.description}
  ><section class="container section section-intro">
    <div>
      <Eyebrow text={site.ui.artwork.eyebrow} /><h1>
        {site.ui.artwork.heading}
      </h1><p class="lead">{site.ui.artwork.intro}</p><div
        class="filters"
        aria-label={site.ui.artwork.filtersLabel}
        role="group"
      >
        <button type="button" data-filter="all" aria-pressed="true">
          {site.ui.artwork.all}
        </button>{
          collections.map((collection) => (
            <button
              type="button"
              data-filter="collection"
              data-collection={collection}
            >
              {collection}
            </button>
          ))
        }<button type="button" data-filter="available"
          >{site.ui.artwork.available}</button
        >
      </div>
    </div>
    {
      site.ui.artwork.heroImage && (
        <div class="section-intro__media">
          <GalleryImage
            src={site.ui.artwork.heroImage}
            alt={site.ui.artwork.heroImageAlt || site.ui.artwork.heading}
            loading="eager"
          />
        </div>
      )
    }
  </section><section class="container section">
    <div class="grid grid-2">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section></BaseLayout
>

<script is:inline src="/scripts/obra-filters.js"></script>
