---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import site from '../../data/site.json';
const works = await getCollection('obras', ({ data }) => !data.draft);
const collections = [
  ...new Set(works.map((work) => work.data.collection)),
].sort((first, second) => first.localeCompare(second));
---

<BaseLayout
  title={site.ui.artwork.title}
  description={site.ui.artwork.description}
  ><section class="container section">
    <p class="eyebrow">{site.ui.artwork.eyebrow}</p><h1>
      {site.ui.artwork.heading}
    </h1><p class="lead">{site.ui.artwork.intro}</p><div
      class="filters"
      aria-label={site.ui.artwork.filtersLabel}
      role="group"
    >
      <button type="button" data-filter="all" aria-pressed="true">
        {site.ui.artwork.all}
      </button>{
        collections.map((collection) => (
          <button
            type="button"
            data-filter="collection"
            data-collection={collection}
          >
            {collection}
          </button>
        ))
      }<button type="button" data-filter="available"
        >{site.ui.artwork.available}</button
      >
    </div><div class="grid grid-2">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section></BaseLayout
>

<script is:inline src="/scripts/obra-filters.js"></script>
