---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import GalleryFilters from '../../components/GalleryFilters.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import { artworkCollections, site } from '../../data';
import RichText from '../../components/RichText.astro';
const works = await getCollection('obras', ({ data }) => !data.draft);

const collections = (artworkCollections.collections ?? []).map((collection) => {
  const collectionWorks = works.filter(
    (work) => work.data.collection === collection.id,
  );
  const source = collectionWorks.find(
    (work) =>
      work.id === collection.imageFrom ||
      work.data.title === collection.imageFrom,
  );
  return {
    id: collection.id,
    label: collection.title,
    count: collectionWorks.length,
    featured: collection.featured,
    image: collection.image ?? source?.data.cover,
    imageAlt: collection.imageAlt ?? source?.data.coverAlt,
  };
});
const artworkStatuses = [
  {
    id: 'disponible',
    label: site.ui.artwork.available ?? 'Disponibles',
    count: works.filter((work) => work.data.status === 'disponible').length,
  },
  { id: 'all', label: site.ui.artwork.all ?? 'Todas', count: works.length },
  {
    id: 'vendida',
    label: 'Vendidas',
    count: works.filter((work) => work.data.status === 'vendida').length,
  },
];
---

<BaseLayout
  title={site.ui.artwork.title}
  description={site.ui.artwork.description}
  showBackToTop
>
  <div data-gallery data-gallery-taxonomy-param="collection">
    <section class="container section page-opening artwork-opening">
      <div class="page-opening__copy" data-reveal>
        <Eyebrow text={site.ui.artwork.eyebrow} /><h1>
          {site.ui.artwork.heading}
        </h1><RichText content={site.ui.artwork.intro} class="lead" />
      </div>
      {
        site.ui.artwork.heroImage && (
          <GalleryImage
            src={site.ui.artwork.heroImage}
            alt={site.ui.artwork.heroImageAlt || site.ui.artwork.heading || ''}
            loading="eager"
            class="page-opening__image"
          />
        )
      }
      <div class="artwork-filters">
        <GalleryFilters
          taxonomyLabel={site.ui.artwork.taxonomyLabel ?? ''}
          taxonomyAllLabel="Todas las colecciones"
          featuredLabel="Colecciones destacadas"
          statusLabel={site.ui.artwork.statusLabel ?? ''}
          activeLabel={site.ui.artwork.activeFiltersLabel ?? ''}
          clearLabel={site.ui.artwork.clearFiltersLabel ?? 'Limpiar'}
          filterLabel={site.ui.artwork.filterLabel ?? 'Filtros'}
          applyLabel={site.ui.artwork.applyLabel ?? 'Ver resultados'}
          showStatusCounts={site.ui.artwork.showStatusCounts ?? false}
          showCategoryCounts={site.ui.artwork.showCategoryCounts ?? false}
          showResultCount={false}
          showActiveFilters={site.ui.artwork.showActiveFilters ?? true}
          showClearButton={site.ui.artwork.showClearButton ?? true}
          showTaxonomySearch={site.ui.artwork.showTaxonomySearch ?? true}
          taxonomySearchLabel={site.ui.artwork.taxonomySearchLabel ??
            'Buscar colecciones'}
          showGlobalSearch={site.ui.artwork.showGlobalSearch ?? true}
          globalSearchLabel={site.ui.artwork.globalSearchLabel ?? ''}
          globalSearchPlaceholder={site.ui.artwork.globalSearchPlaceholder ??
            'Buscar por título'}
          searchParam={site.ui.artwork.searchParam ?? 'search'}
          itemLabel="obras"
          emptyLabel="No hay obras que coincidan con estos filtros."
          urlParam="collection"
          defaultStatus="disponible"
          statuses={artworkStatuses}
          taxonomies={collections}
        />
      </div>
    </section><section class="container section gallery-results">
      <div
        class="grid grid-3 gallery-card-grid"
        data-reveal-group
        data-gallery-results-grid
        tabindex="-1"
      >
        {works.map((work) => <WorkCard work={work} />)}
      </div>
      <div class="pagination-layout" data-gallery-pagination>
        <nav
          data-gallery-pagination-controls
          data-page-size="6"
          data-page-size-tablet="6"
          data-page-size-desktop="8"
          aria-label={site.ui.artwork.paginationLabel ?? 'Paginación de obra'}
          data-previous-label={site.ui.artwork.previous ?? 'Anterior'}
          data-next-label={site.ui.artwork.next ?? 'Siguiente'}
          data-page-status={site.ui.artwork.pageStatus ??
            'Página {currentPage} de {pageCount}'}
        >
        </nav>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline src="/scripts/gallery-filters.js"></script>

<style>
  .artwork-opening {
    align-items: center;
  }
  .artwork-filters {
    grid-column: 1 / -1;
  }
  .gallery-results {
    padding-top: 0;
  }
  :global([data-gallery-results-grid]:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .pagination-layout,
  [data-gallery-pagination-controls] {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .pagination-layout {
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .pagination-layout[hidden],
  [data-gallery-pagination-controls][hidden] {
    display: none;
  }
  :global([data-gallery-pagination-controls] button) {
    min-height: 2rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  :global([data-gallery-pagination-controls] button:disabled) {
    cursor: default;
    opacity: 0.5;
  }
  @media (min-width: 1024px) {
    :global(.gallery-results .gallery-card-grid) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .artwork-opening :global(.page-opening__image) {
      display: none;
    }
  }
</style>
