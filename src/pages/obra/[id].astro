---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import TallyLink from '../../components/TallyLink.astro';
import { forms } from '../../config/forms';
import site from '../../data/site.json';
export async function getStaticPaths() {
  return (await getCollection('obras', ({ data }) => !data.draft)).map(
    (work) => ({ params: { id: work.id }, props: { work } }),
  );
}
const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={work.data.title} description={work.data.description}
  ><article class="container section">
    <p class="eyebrow">
      {site.ui.artwork.detailEyebrow} / {work.data.collection}
    </p><h1>
      {work.data.title}
    </h1><div class="grid grid-2">
      <GalleryImage
        src={work.data.cover}
        alt={work.data.coverAlt}
        loading="eager"
      /><div>
        <span class="status">{work.data.status}</span><p>
          {work.data.technique}<br />{work.data.dimensions}
        </p>{
          work.data.showPrice && work.data.priceEur ? (
            <h3>{work.data.priceEur} €</h3>
          ) : null
        }<p>{site.ui.artwork.shipping}</p><div class="prose">
          <Content />
        </div><TallyLink
          url={forms.artwork}
          params={{ artworkId: work.id, source: 'portfolio-obra' }}
          >{site.ui.artwork.interestCta}</TallyLink
        >
      </div>
    </div>{
      work.data.gallery.map((image: any) => (
        <GalleryImage src={image.src} alt={image.alt} />
      ))
    }
  </article></BaseLayout
>
