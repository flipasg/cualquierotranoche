---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryImage from '../components/GalleryImage.astro';
const page = await getEntry('paginas', 'sobre-mi');
if (!page || page.data.draft) throw new Error('Página Sobre mí no disponible');
const { Content } = await render(page);
---

<BaseLayout
  title="Sobre mí"
  description="Presentación de la artista y su práctica."
  ><section class="container section grid grid-2">
    <GalleryImage
      src={page.data.portrait}
      alt={page.data.portraitAlt}
      loading="eager"
    /><div>
      <h1>{page.data.title}</h1><h3>
        {page.data.subtitle}
      </h3><div class="prose"><Content /></div><p>
        <strong>{page.data.location}</strong>
      </p>
    </div>
  </section></BaseLayout
>
