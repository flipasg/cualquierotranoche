---
import {getEntry,render} from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import GalleryImage from '../components/GalleryImage.astro';import site from '../data/site.json';const page=await getEntry('paginas','sobre-mi');if(!page||page.data.draft) throw new Error('Página Sobre mí no disponible');const {Content}=await render(page);
---
<BaseLayout title="Sobre mí" description="Presentación de la artista y su práctica."><section class="container section grid grid-2"><GalleryImage src={page.data.portrait} alt={page.data.portraitAlt} loading="eager"/><div><p class="eyebrow">{page.data.eyebrow}</p><h1>{page.data.title}</h1><h3>{page.data.subtitle}</h3><div class="prose"><Content/></div><p><strong>{page.data.location}</strong></p></div></section><section class="container section"><h2>¿Lo hablamos?</h2><p>Para un tattoo, una obra o una nueva colaboración.</p><a class="button" href="/contacto/">Contactar</a><p><a href={`mailto:${site.email}`}>Email</a> · <a href={site.instagram}>Instagram</a></p></section><section class="container section editorial"><div><p class="eyebrow">06 / PRESENTACIÓN</p><h3>Una persona detrás</h3><p>El retrato tiene presencia, acompañado por un texto corto y una trayectoria seleccionada.</p></div><div><p class="eyebrow">TONO</p><h3>Directo y propio</h3><p>Estos textos son provisionales. La voz final y la fotografía deben ser suyas.</p></div><div><p class="eyebrow">CONTINUIDAD</p><h3>El contacto sigue a mano</h3><p>La página cierra con una invitación sencilla y los canales de contacto.</p></div></section></BaseLayout>
