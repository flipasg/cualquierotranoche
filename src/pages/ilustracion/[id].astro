---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import TallyLink from '../../components/TallyLink.astro';
import { forms } from '../../config/forms';
import site from '../../data/site.json';
export async function getStaticPaths() {
  return (await getCollection('proyectos', ({ data }) => !data.draft)).map(
    (project) => ({ params: { id: project.id }, props: { project } }),
  );
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}
  ><article class="container section">
    <p class="eyebrow">
      {site.ui.illustration.title} / {site.ui.illustration.projectEyebrow}
    </p><h1>
      {project.data.title}
    </h1><p>
      {project.data.client} · {project.data.services} · {project.data.year}
    </p><p class="lead">{project.data.description}</p><GalleryImage
      src={project.data.cover}
      alt={project.data.coverAlt}
      loading="eager"
    /><section class="section prose">
      <p class="eyebrow">{site.ui.illustration.contributionEyebrow}</p><h2>
        {project.data.contribution}
      </h2><Content />
    </section>{
      project.data.gallery.map((image: any) => (
        <figure>
          <>
            <GalleryImage src={image.src} alt={image.alt} />
            <figcaption>{image.alt}</figcaption>
          </>
        </figure>
      ))
    }<section class="section">
      <h2>{site.ui.illustration.contactHeading}</h2><TallyLink
        url={forms.illustration}
        params={{ source: 'portfolio-proyecto' }}
        >{site.ui.illustration.contactCta}</TallyLink
      >
    </section>
  </article></BaseLayout
>
