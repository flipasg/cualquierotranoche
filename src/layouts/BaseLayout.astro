---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageViewer from '../components/ImageViewer.astro';
import BackToTop from '../components/BackToTop.astro';
import SocialMeta from '../components/SocialMeta.astro';
import { site } from '../data';
import { social } from '../config/social';
import { resolveSocial } from '../lib/social';
import { themeStyle } from '../lib/theme';
import media from '../generated/media.json';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  showBackToTop?: boolean;
}
const {
  title,
  description,
  showFooter = true,
  socialImage,
  socialImageAlt,
  showBackToTop = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const mediaPath = (path: string) =>
  media[path as keyof typeof media]?.src ?? path;
const favicon = mediaPath(social.favicon);
const metadata = resolveSocial(
  social,
  {
    pathname: Astro.url.pathname,
    title: `${title} · ${site.artisticName}`,
    description: `${description}`,
    image: socialImage,
    imageAlt: socialImageAlt,
  },
  media,
);
---

<!doctype html>
<html lang="es" style={themeStyle(site.theme)}>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><link rel="preconnect" href="https://fonts.googleapis.com" /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    /><link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;600;700&display=swap"
    /><meta name="description" content={description} /><link
      rel="icon"
      href={favicon}
    /><link rel="canonical" href={canonical} /><SocialMeta
      metadata={metadata}
      canonical={canonical}
      siteName={`${site.artisticName}`}
    /><title>
      {title} · {site.artisticName}
    </title></head
  ><body id="top"
    ><a class="skip-link" href="#contenido">{site.ui.skipLink}</a><Header
    /><main id="contenido"><slot /></main>{showFooter && <Footer />}<ImageViewer
    />{showBackToTop && <BackToTop />}<script
      is:inline
      type="module"
      src="/scripts/responsive-external-links.js"></script><script
      is:inline
      type="module"
      src="/scripts/scroll-reveal.js"></script></body
  >
</html>
