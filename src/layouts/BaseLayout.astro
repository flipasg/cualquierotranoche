---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageViewer from '../components/ImageViewer.astro';
import site from '../data/site.json';
import social from '../data/social.json';
import media from '../generated/media.json';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const mediaPath = (path: string) =>
  media[path as keyof typeof media]?.src ?? path;
const favicon = mediaPath(social.favicon);
const socialImage = new URL(mediaPath(social.image), Astro.site);
---

<!doctype html>
<html lang="es">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="description" content={description} /><link
      rel="icon"
      href={favicon}
    /><link rel="canonical" href={canonical} /><meta
      property="og:type"
      content="website"
    /><meta property="og:title" content={social.title} /><meta
      property="og:description"
      content={social.description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:site_name"
      content={site.artisticName}
    /><meta property="og:image" content={socialImage} /><meta
      property="og:image:alt"
      content={social.imageAlt}
    /><meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={social.title}
    /><meta name="twitter:description" content={social.description} /><meta
      name="twitter:image"
      content={socialImage}
    /><meta name="twitter:image:alt" content={social.imageAlt} /><title>
      {title} · {site.artisticName}
    </title></head
  ><body
    ><a class="skip-link" href="#contenido">{site.ui.skipLink}</a><Header
    /><main id="contenido"><slot /></main><Footer /><ImageViewer /></body
  >
</html>
