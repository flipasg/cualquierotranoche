---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageViewer from '../components/ImageViewer.astro';
import BackToTop from '../components/BackToTop.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { analytics } from '../config/analytics';
import SocialMeta from '../components/SocialMeta.astro';
import { site } from '../data';
import { social } from '../config/social';
import { resolveSocial } from '../lib/social';
import { resolveSeo, serializeJsonLd } from '../lib/seo.mjs';
import { richTextToPlainText } from '../lib/rich-text.mjs';
import { themeFontStylesheets, themeStyle } from '../lib/theme';
import media from '../generated/media.json';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  seoTitle?: string;
  seoDescription?: string;
  showFooter?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  showBackToTop?: boolean;
}
const {
  title,
  description,
  seoTitle,
  seoDescription,
  showFooter = true,
  socialImage,
  socialImageAlt,
  showBackToTop = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const seo = resolveSeo(
  { title, description, seoTitle, seoDescription },
  site.artisticName,
);
const siteName = richTextToPlainText(site.artisticName);
const website =
  Astro.url.pathname === '/' && siteName
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: canonical.href,
      }
    : undefined;
const mediaPath = (path: string) =>
  media[path as keyof typeof media]?.src ?? path;
const favicon = mediaPath(social.favicon);
const metadata = resolveSocial(
  social,
  {
    pathname: Astro.url.pathname,
    title: seo.title,
    description: seo.description,
    image: socialImage,
    imageAlt: socialImageAlt,
  },
  media,
);
---

<!doctype html>
<html lang="es" style={themeStyle(site.theme)}>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><link rel="preconnect" href="https://fonts.googleapis.com" /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />{
      themeFontStylesheets(site.theme).map((href) => (
        <link rel="stylesheet" href={href} referrerpolicy="no-referrer" />
      ))
    }{
      seo.description && <meta name="description" content={seo.description} />
    }<link rel="icon" href={favicon} /><link
      rel="canonical"
      href={canonical}
    /><SocialMeta
      metadata={metadata}
      canonical={canonical}
      siteName={siteName}
    /><title>{seo.title}</title>{
      website && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd(website)}
        />
      )
    }</head
  ><body id="top"
    ><a class="skip-link" href="#contenido">{site.ui.skipLink}</a><Header
    /><main id="contenido"><slot /></main>{showFooter && <Footer />}<ImageViewer
    />{showBackToTop && <BackToTop />}<AnalyticsConsent
      config={analytics}
      origin={new URL(Astro.site ?? canonical).origin}
      owner={site.ui.contact.copyrightLabel || site.name}
      email={site.email}
    /><script
      is:inline
      type="module"
      src="/scripts/responsive-external-links.js"></script><script
      is:inline
      type="module"
      src="/scripts/scroll-reveal.js"></script><script
      is:inline
      type="module"
      src="/scripts/guest-expiry.js"></script></body
  >
</html>
