{
  "name": "portfolio-artistico",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-content.mjs",
    "media": "node scripts/prepare-media.mjs",
    "prepare:content": "npm run validate && npm run media",
    "dev": "npm run prepare:content && astro dev",
    "build": "npm run prepare:content && astro check && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "marked": "^18.0.14",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3"
  }
}
